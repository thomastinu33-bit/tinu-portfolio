---
import { site } from '../data/site';

interface Props {
	title?: string;
	description?: string;
}

const { title = `${site.name} · ${site.role}`, description = site.tagline } = Astro.props;
const base = import.meta.env.BASE_URL;
const [firstName, ...rest] = site.name.split(' ');
const lastName = rest.join(' ');

const navLinks = [
	{ label: 'Home', href: `${base}/` },
	{ label: 'Case Studies', href: `${base}/#work` },
	{ label: 'About', href: `${base}/#about` },
	{ label: 'Resume', href: `${base}/${site.resume}` },
];
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
		<link rel="icon" href={`${base}/favicon.ico`} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<header class="nav-wrap">
			<div class="nav glass">
				<a class="brand" href={`${base}/`} aria-label={`${site.name}, home`}>
					<span>{firstName}</span>
					<span>{lastName}</span>
				</a>
				<nav aria-label="Main">
					{navLinks.map((l) => <a href={l.href}>{l.label}</a>)}
				</nav>
			</div>
		</header>
		<main>
			<slot />
		</main>
		<footer id="contact" class="footer">
			<div class="container">
				<h2>Get in touch</h2>
				<ul class="contact">
					<li><a href={`mailto:${site.email}`}>{site.email}</a></li>
					<li><a href={site.linkedin} target="_blank" rel="noopener">LinkedIn</a></li>
					<li>{site.location}</li>
				</ul>
				<p class="copyright">© {new Date().getFullYear()} {site.name}</p>
			</div>
		</footer>
	</body>
</html>

<style is:global>
	:root {
		--fg: #2b2b2b;
		--muted: #6a6a6a;
		--accent: #3f8f9a;
		--border: rgba(255, 255, 255, 0.7);
		--card: rgba(255, 255, 255, 0.55);
		--glass: rgba(255, 255, 255, 0.6);
		--glass-border: rgba(90, 50, 30, 0.07);
		--glass-shadow: 0 8px 30px rgba(120, 70, 40, 0.06);
		--gradient: linear-gradient(121deg, #ffffff 0%, #fff3ec 100%);
		color-scheme: light;
	}
	* {
		box-sizing: border-box;
	}
	html {
		scroll-behavior: smooth;
		scroll-padding-top: 110px;
	}
	body {
		margin: 0;
		min-height: 100vh;
		background: #ffffff;
		color: var(--fg);
		font-family: 'Poppins', system-ui, -apple-system, sans-serif;
		font-weight: 300;
		line-height: 1.6;
	}
	a {
		color: var(--accent);
	}
	.container {
		max-width: 960px;
		margin: 0 auto;
		padding: 0 20px;
	}

	/* Frosted-glass surface, reused by the nav and cards */
	.glass {
		background: var(--glass);
		-webkit-backdrop-filter: blur(24px) saturate(160%);
		backdrop-filter: blur(24px) saturate(160%);
		border: 1px solid var(--glass-border);
		box-shadow: var(--glass-shadow);
	}

	.nav-wrap {
		position: fixed;
		inset: 24px 24px auto;
		z-index: 10;
	}
	.nav {
		max-width: 1100px;
		margin: 0 auto;
		height: 64px;
		padding: 0 32px;
		border-radius: 999px;
		display: flex;
		justify-content: space-between;
		align-items: center;
	}
	.brand {
		display: flex;
		flex-direction: column;
		color: var(--fg);
		text-decoration: none;
		text-transform: uppercase;
		font-weight: 400;
		font-size: 0.95rem;
		letter-spacing: 0.18em;
		line-height: 1.15;
	}
	.nav nav {
		display: flex;
		gap: 32px;
	}
	.nav nav a {
		color: var(--fg);
		opacity: 0.8;
		text-decoration: none;
		font-size: 1rem;
		transition: opacity 0.15s;
	}
	.nav nav a:hover {
		opacity: 1;
	}
	@media (max-width: 600px) {
		.nav-wrap {
			inset: 12px 12px auto;
		}
		.nav {
			height: 56px;
			padding: 0 20px;
		}
		.brand {
			font-size: 0.8rem;
			letter-spacing: 0.14em;
		}
		.nav nav {
			gap: 14px;
		}
		.nav nav a {
			font-size: 0.85rem;
		}
	}
	@media (max-width: 380px) {
		.nav nav a:first-child {
			display: none;
		}
	}

	.footer {
		margin-top: 48px;
		padding: 64px 0 32px;
		border-top: 1px solid rgba(90, 50, 30, 0.08);
		text-align: center;
	}
	.footer h2 {
		font-weight: 500;
		margin: 0 0 16px;
	}
	.contact {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 8px 28px;
		font-size: 1.05rem;
	}
	.contact a {
		color: var(--fg);
		text-underline-offset: 4px;
	}
	.contact a:hover {
		color: var(--accent);
	}
	.copyright {
		color: var(--muted);
		font-size: 0.85rem;
		margin: 40px 0 0;
	}
</style>
