---
import Layout from '../layouts/Layout.astro';
import { site, projects } from '../data/site';
---

<Layout>
	<section class="hero">
		<p class="eyebrow">{site.role}</p>
		<h1>Hi, I'm {site.name}.</h1>
		<p class="lead">{site.tagline}</p>
	</section>

	<section id="work">
		<h2>Case Studies</h2>
		<div class="grid">
			{
				projects.map((p) => (
					<article class="card glass">
						<h3>{p.href ? <a href={p.href}>{p.title}</a> : p.title}</h3>
						<p>{p.summary}</p>
						<ul class="tags">
							{p.tags.map((t) => (
								<li>{t}</li>
							))}
						</ul>
					</article>
				))
			}
		</div>
	</section>

	<section id="about">
		<h2>About</h2>
		<p>{site.about}</p>
	</section>

	<section id="contact">
		<h2>Contact</h2>
		<p>
			Say hello at <a href={`mailto:${site.email}`}>{site.email}</a>
		</p>
		<ul class="links">
			{
				site.links.map((l) => (
					<li>
						<a href={l.href}>{l.label}</a>
					</li>
				))
			}
		</ul>
	</section>
</Layout>

<style>
	section {
		padding: 48px 0;
	}
	.hero {
		padding: 72px 0 48px;
	}
	.eyebrow {
		color: var(--muted);
		text-transform: uppercase;
		letter-spacing: 0.08em;
		font-size: 0.85rem;
		margin: 0;
	}
	h1 {
		font-weight: 400;
		font-size: clamp(2.2rem, 6vw, 3.6rem);
		line-height: 1.1;
		margin: 8px 0 16px;
	}
	.lead {
		font-size: 1.25rem;
		color: var(--muted);
		max-width: 40ch;
	}
	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
		gap: 20px;
	}
	.card {
		border-radius: 12px;
		padding: 20px;
	}
	.card h3 {
		margin-top: 0;
		font-weight: 500;
	}
	.tags,
	.links {
		list-style: none;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
	}
	.tags li {
		font-size: 0.8rem;
		color: var(--muted);
		border: 1px solid var(--border);
		border-radius: 999px;
		padding: 2px 10px;
	}
	.links {
		gap: 16px;
	}
</style>
