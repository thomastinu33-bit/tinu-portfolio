---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import PasswordGate from '../components/PasswordGate.astro';
import { site, projects, strengths, howIWork } from '../data/site';
import Mail from '@lucide/astro/icons/mail';
import MapPin from '@lucide/astro/icons/map-pin';
import ArrowUpRight from '@lucide/astro/icons/arrow-up-right';
import Component from '@lucide/astro/icons/component';
import MousePointerClick from '@lucide/astro/icons/mouse-pointer-click';
import ScanSearch from '@lucide/astro/icons/scan-search';
import GitPullRequest from '@lucide/astro/icons/git-pull-request';

const base = import.meta.env.BASE_URL;
const coreIcons = { research: ScanSearch, prototype: MousePointerClick, ship: GitPullRequest };
const strengthIcons = { component: Component, prototype: MousePointerClick, research: ScanSearch };
---

<Layout>
	<section class="hero">
		<div class="container hero-inner">
			<h1 class="greeting">Hi, I'm {site.name}</h1>
			<!-- All lines share one grid cell, so the hero keeps the height of the longest line and never jumps. -->
			<p class="rotator" aria-hidden="true">
				{site.intro.map((line, i) => <span class:list={{ 'is-active': i === 0 }}>{line}</span>)}
			</p>
			<p class="sr-only">{site.intro.join('. ')}.</p>
		</div>
		<div id="contact" class="hero-meta nav-width">
			<div class="touch">
				<span class="meta-label">Get in touch</span>
				<a class="meta-link" href={`mailto:${site.email}`}>
					<Mail size={16} strokeWidth={1.75} aria-hidden="true" />
					{site.email}
				</a>
				<a class="meta-link" href={site.linkedin} target="_blank" rel="noopener">
					LinkedIn
					<ArrowUpRight size={16} strokeWidth={1.75} aria-hidden="true" />
				</a>
			</div>
			<div class="location">
				<span class="meta-label">Based in</span>
				<span class="meta-link">
					<MapPin size={16} strokeWidth={1.75} aria-hidden="true" />
					{site.location}
				</span>
			</div>
		</div>
	</section>

	<section class="strengths nav-width" aria-label="What I do">
		<ul>
			{
				strengths.map((s) => {
					const Icon = strengthIcons[s.icon];
					return (
						<li>
							<span class="badge">
								<Icon size={20} strokeWidth={1.5} aria-hidden="true" />
							</span>
							<div>
								<h3>{s.title}</h3>
								<p>{s.note}</p>
							</div>
						</li>
					);
				})
			}
		</ul>
	</section>

	<!-- Everything below the strip is private until the password is entered (see the script at the bottom). -->
	<div id="gate-sentinel" aria-hidden="true"></div>
	<div id="gated" class="gated">
	<section id="work" class="nav-width">
		<h2>Case Studies</h2>

		<div class="stack">
			{
				projects.map((p) => (
					<a class="featured" href={p.slug ? `${base}/case-studies/${p.slug}/` : undefined}>
						<div class="featured-text">
							<p class="eyebrow">{p.tags[0]}</p>
							<h3>{p.title}</h3>
							{p.highlights && (
								<ul class="highlights">
									{p.highlights.map((h) => (
										<li>{h}</li>
									))}
								</ul>
							)}
							<span class="cta">
								Read the case study
								<ArrowUpRight size={18} strokeWidth={1.5} aria-hidden="true" />
							</span>
						</div>
						<div class="featured-media">
							{p.cover && (
								<div class:list={['window', { bare: p.cover.bare }]}>
									{!p.cover.bare && (
										<div class="chrome" aria-hidden="true">
											<span />
											<span />
											<span />
										</div>
									)}
									<Image
										src={p.cover.image}
										alt={p.cover.alt}
										widths={[800, 1200, 1600]}
										sizes="(max-width: 900px) 100vw, 620px"
									/>
								</div>
							)}
						</div>
					</a>
				))
			}
		</div>
	</section>

	<section id="how-i-work" class="nav-width">
		<h2>How I work</h2>
		<div class="story">
			{howIWork.story.map((para) => <p>{para}</p>)}
		</div>

		<p class="core-intro">{howIWork.coreIntro}</p>
		<ul class="core">
			{
				howIWork.core.map((c, i) => {
					const Icon = coreIcons[c.icon];
					return (
						<li>
							<span class="c-top">
								<span class="c-badge">
									<Icon size={20} strokeWidth={1.5} aria-hidden="true" />
								</span>
								<span class="c-n">0{i + 1}</span>
							</span>
							<h3>{c.title}</h3>
							<p>{c.body}</p>
						</li>
					);
				})
			}
		</ul>
		<p class="team">{howIWork.team}</p>
	</section>

	<div class="container">
		<section id="about">
			<h2>About</h2>
			<p>{site.about}</p>
		</section>
	</div>
	</div>

	<PasswordGate mode="scroll" />
</Layout>

<script>
	const lines = document.querySelectorAll<HTMLElement>('.rotator span');
	let current = 0;
	if (lines.length > 1) {
		setInterval(() => {
			lines[current].classList.remove('is-active');
			current = (current + 1) % lines.length;
			lines[current].classList.add('is-active');
		}, 4500);
	}
</script>

<style>
	section {
		padding-block: 48px;
	}
	/* Full-screen gradient intro; everything after it sits below the fold on white */
	.hero {
		min-height: 100vh;
		min-height: 100svh;
		display: flex;
		align-items: center;
		position: relative;
		padding: 112px 0 140px;
		background: var(--gradient);
	}
	/* Contact details pinned to the bottom corners of the first screen */
	.hero-meta {
		position: absolute;
		left: 0;
		right: 0;
		bottom: 36px;
		display: flex;
		justify-content: space-between;
		align-items: flex-end;
		gap: 16px;
		font-size: 0.95rem;
	}
	.touch {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 4px 20px;
	}
	.location {
		flex-shrink: 0;
		text-align: right;
		white-space: nowrap;
	}
	.meta-label {
		display: block;
		width: 100%;
		color: var(--muted);
		font-size: 0.75rem;
		text-transform: uppercase;
		letter-spacing: 0.12em;
	}
	.meta-link {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		color: var(--fg);
		text-decoration: none;
	}
	.meta-link svg {
		flex-shrink: 0;
		color: var(--muted);
		transition: color 0.15s, transform 0.15s;
	}
	a.meta-link:hover,
	a.meta-link:hover svg {
		color: var(--accent);
	}
	a.meta-link:hover svg.lucide-arrow-up-right {
		transform: translate(2px, -2px);
	}
	@media (max-width: 600px) {
		.hero-meta {
			bottom: 24px;
			font-size: 0.85rem;
		}
	}
	.hero .container {
		width: 100%;
	}
	.hero-inner {
		text-align: center;
	}
	.greeting {
		font-family: var(--font-sans);
		font-weight: 300;
		letter-spacing: 0.01em;
		font-size: clamp(1.4rem, 3vw, 1.9rem);
		color: var(--muted);
		margin: 0 0 6px;
	}
	.rotator {
		display: grid;
		max-width: 30ch;
		margin: 0 auto;
		font-family: var(--font-serif);
		font-weight: 400;
		font-size: clamp(2rem, 4.6vw, 3.2rem);
		line-height: 1.1;
		letter-spacing: -0.01em;
		font-variant-numeric: lining-nums;
	}
	.rotator span {
		grid-area: 1 / 1;
		align-self: start;
		opacity: 0;
		transform: translateY(12px);
		transition:
			opacity 0.6s ease,
			transform 0.6s ease;
	}
	.rotator span.is-active {
		opacity: 1;
		transform: none;
	}
	@media (prefers-reduced-motion: reduce) {
		.rotator span {
			transform: none;
			transition: none;
		}
	}
	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
	}
	/* "What I do" strip */
	.strengths {
		padding-block: 48px;
		border-bottom: 1px solid rgba(90, 50, 30, 0.08);
	}
	.strengths ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 32px;
	}
	.strengths li {
		display: flex;
		align-items: center;
		gap: 16px;
	}
	.badge {
		flex-shrink: 0;
		display: grid;
		place-items: center;
		width: 48px;
		height: 48px;
		border-radius: 8px;
		background: #fbede5;
		border: 1px solid rgba(200, 130, 95, 0.18);
		color: #b0694a;
	}
	.strengths h3 {
		margin: 0;
		font-size: 1.6rem;
		line-height: 1.15;
	}
	.strengths p {
		margin: 2px 0 0;
		color: var(--muted);
		line-height: 1.4;
	}
	@media (max-width: 820px) {
		.strengths ul {
			grid-template-columns: 1fr;
			gap: 24px;
		}
	}
	#work h2 {
		text-align: center;
	}
	#gate-sentinel {
		height: 0;
	}
	/* How I work */
	#how-i-work h2 {
		text-align: center;
		margin-bottom: 24px;
	}
	.story {
		max-width: 760px;
		margin: 0 auto;
		display: grid;
		gap: 18px;
	}
	.story p {
		margin: 0;
		font-family: var(--font-serif);
		font-size: clamp(1.3rem, 2.4vw, 1.65rem);
		line-height: 1.45;
		color: var(--fg);
	}
	.core-intro {
		max-width: 760px;
		margin: 44px auto 18px;
		font-size: 0.78rem;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--muted);
	}
	.core {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 16px;
	}
	.core li {
		padding: clamp(20px, 2.6vw, 28px);
		border-radius: 20px;
		background: #f6f6f6;
		border: 1px solid #ececec;
	}
	.c-top {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin-bottom: 18px;
	}
	.c-badge {
		display: grid;
		place-items: center;
		width: 44px;
		height: 44px;
		border-radius: 8px;
		background: #fff;
		border: 1px solid #e3e3e3;
		color: #555;
	}
	.c-n {
		font-family: var(--font-serif);
		font-variant-numeric: lining-nums;
		font-size: 1.5rem;
		color: #c4c4c4;
	}
	.core h3 {
		margin: 0 0 8px;
		font-size: clamp(1.4rem, 2.2vw, 1.75rem);
		line-height: 1.2;
	}
	.core p {
		margin: 0;
		color: var(--muted);
		line-height: 1.55;
	}
	.team {
		max-width: 760px;
		margin: 28px auto 0;
		padding-top: 22px;
		border-top: 1px solid #ececec;
		font-size: 1.05rem;
		line-height: 1.55;
		color: var(--fg);
	}
	@media (max-width: 820px) {
		.core {
			grid-template-columns: 1fr;
		}
	}

	/* Case studies: a stack of panels, each with a short summary beside a large picture */
	.eyebrow {
		margin: 0;
		font-size: 0.75rem;
		text-transform: uppercase;
		letter-spacing: 0.14em;
		color: var(--muted);
	}
	.stack {
		display: grid;
		gap: 28px;
		margin-top: 24px;
	}
	.featured {
		display: grid;
		grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
		gap: clamp(24px, 4vw, 56px);
		align-items: center;
		padding: clamp(20px, 4vw, 48px);
		border-radius: 24px;
		background: #f6f6f6;
		border: 1px solid #ececec;
		color: inherit;
		text-decoration: none;
	}
	.featured:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 6px;
	}
	.featured h3 {
		margin: 14px 0 0;
		font-size: clamp(1.7rem, 3vw, 2.3rem);
		line-height: 1.15;
	}
	.highlights {
		list-style: none;
		margin: 22px 0 0;
		padding: 0;
		display: grid;
		gap: 8px;
		color: var(--muted);
	}
	.highlights li {
		display: flex;
		gap: 10px;
	}
	.highlights li::before {
		content: '–';
		color: var(--fg);
	}
	.cta {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		margin-top: 26px;
		padding-bottom: 3px;
		border-bottom: 1.5px solid var(--fg);
		transition:
			gap 0.3s,
			border-color 0.3s;
	}
	.featured:hover .cta,
	.featured:focus-visible .cta {
		gap: 10px;
	}
	.featured-media {
		display: grid;
		place-items: center;
		overflow: hidden;
		padding: clamp(14px, 2.4vw, 28px);
		border-radius: 18px;
		background: #fff;
		border: 1px solid #ececec;
	}
	.window {
		width: 100%;
		border-radius: 12px;
		overflow: hidden;
		background: #fff;
		border: 1px solid #e3e3e3;
		box-shadow:
			0 24px 50px -20px rgba(0, 0, 0, 0.18),
			0 8px 20px rgba(0, 0, 0, 0.06);
		transition:
			transform 0.7s cubic-bezier(0.2, 0.7, 0.2, 1),
			box-shadow 0.7s ease;
	}
	/* An image that is already a mockup: no frame, no shadow, just rounded corners */
	.window.bare {
		border: 0;
		box-shadow: none;
		background: none;
	}
	.window :global(img) {
		display: block;
		width: 100%;
		height: auto;
	}
	.chrome {
		display: flex;
		gap: 6px;
		padding: 9px 12px;
		background: #f3f3f3;
		border-bottom: 1px solid rgba(0, 0, 0, 0.06);
	}
	.chrome span {
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background: #d9d9d9;
	}
	@media (hover: hover) {
		.featured:hover .window,
		.featured:focus-visible .window {
			transform: scale(1.06);
			box-shadow:
				0 34px 70px -24px rgba(0, 0, 0, 0.28),
				0 12px 28px rgba(0, 0, 0, 0.08);
		}
	}
	@media (max-width: 820px) {
		.featured {
			grid-template-columns: 1fr;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.window,
		.cta {
			transition: none;
		}
	}
</style>
