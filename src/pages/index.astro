---
import Layout from '../layouts/Layout.astro';
import FlowHero from '../components/FlowHero.astro';
import { site, projects, strengths } from '../data/site';
import Mail from '@lucide/astro/icons/mail';
import MapPin from '@lucide/astro/icons/map-pin';
import ArrowUpRight from '@lucide/astro/icons/arrow-up-right';
import Component from '@lucide/astro/icons/component';
import MousePointerClick from '@lucide/astro/icons/mouse-pointer-click';
import ScanSearch from '@lucide/astro/icons/scan-search';

const base = import.meta.env.BASE_URL;
const strengthIcons = { component: Component, prototype: MousePointerClick, research: ScanSearch };
---

<Layout>
	<section class="hero">
		<div class="container hero-inner">
			<h1 class="greeting">Hi, I'm {site.name}</h1>
			<!-- All lines share one grid cell, so the hero keeps the height of the longest line and never jumps. -->
			<p class="rotator" aria-hidden="true">
				{site.intro.map((line, i) => <span class:list={{ 'is-active': i === 0 }}>{line}</span>)}
			</p>
			<p class="sr-only">{site.intro.join('. ')}.</p>
		</div>
		<div id="contact" class="hero-meta nav-width">
			<div class="touch">
				<span class="meta-label">Get in touch</span>
				<a class="meta-link" href={`mailto:${site.email}`}>
					<Mail size={16} strokeWidth={1.75} aria-hidden="true" />
					{site.email}
				</a>
				<a class="meta-link" href={site.linkedin} target="_blank" rel="noopener">
					LinkedIn
					<ArrowUpRight size={16} strokeWidth={1.75} aria-hidden="true" />
				</a>
			</div>
			<div class="location">
				<span class="meta-label">Based in</span>
				<span class="meta-link">
					<MapPin size={16} strokeWidth={1.75} aria-hidden="true" />
					{site.location}
				</span>
			</div>
		</div>
	</section>

	<section class="strengths nav-width" aria-label="What I do">
		<ul>
			{
				strengths.map((s) => {
					const Icon = strengthIcons[s.icon];
					return (
						<li>
							<span class="badge">
								<Icon size={20} strokeWidth={1.5} aria-hidden="true" />
							</span>
							<div>
								<h3>{s.title}</h3>
								<p>{s.note}</p>
							</div>
						</li>
					);
				})
			}
		</ul>
	</section>

	<div class="container">
		<section id="work">
			<h2>Case Studies</h2>
			<div class="grid">
				{
					projects.map((p) =>
						p.flow ? (
							<article class="feature">
								<ul class="tags">
									{p.tags.map((t) => (
										<li>{t}</li>
									))}
								</ul>
								<h3>{p.slug ? <a href={`${base}/case-studies/${p.slug}/`}>{p.title}</a> : p.title}</h3>
								<p>{p.summary}</p>
								{p.slug && (
									<a class="read-more" href={`${base}/case-studies/${p.slug}/`}>
										Read the case study
										<ArrowUpRight size={16} strokeWidth={1.75} aria-hidden="true" />
									</a>
								)}
								<FlowHero steps={p.flow} />
							</article>
						) : (
							<article class="card glass">
								<h3>{p.href ? <a href={p.href}>{p.title}</a> : p.title}</h3>
								<p>{p.summary}</p>
								<ul class="tags">
									{p.tags.map((t) => (
										<li>{t}</li>
									))}
								</ul>
							</article>
						),
					)
				}
			</div>
		</section>

		<section id="about">
			<h2>About</h2>
			<p>{site.about}</p>
		</section>
	</div>
</Layout>

<script>
	const lines = document.querySelectorAll<HTMLElement>('.rotator span');
	let current = 0;
	if (lines.length > 1) {
		setInterval(() => {
			lines[current].classList.remove('is-active');
			current = (current + 1) % lines.length;
			lines[current].classList.add('is-active');
		}, 4500);
	}
</script>

<style>
	section {
		padding-block: 48px;
	}
	/* Full-screen gradient intro; everything after it sits below the fold on white */
	.hero {
		min-height: 100vh;
		min-height: 100svh;
		display: flex;
		align-items: center;
		position: relative;
		padding: 112px 0 140px;
		background: var(--gradient);
	}
	/* Contact details pinned to the bottom corners of the first screen */
	.hero-meta {
		position: absolute;
		left: 0;
		right: 0;
		bottom: 36px;
		display: flex;
		justify-content: space-between;
		align-items: flex-end;
		gap: 16px;
		font-size: 0.95rem;
	}
	.touch {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 4px 20px;
	}
	.location {
		flex-shrink: 0;
		text-align: right;
		white-space: nowrap;
	}
	.meta-label {
		display: block;
		width: 100%;
		color: var(--muted);
		font-size: 0.75rem;
		text-transform: uppercase;
		letter-spacing: 0.12em;
	}
	.meta-link {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		color: var(--fg);
		text-decoration: none;
	}
	.meta-link svg {
		flex-shrink: 0;
		color: var(--muted);
		transition: color 0.15s, transform 0.15s;
	}
	a.meta-link:hover,
	a.meta-link:hover svg {
		color: var(--accent);
	}
	a.meta-link:hover svg.lucide-arrow-up-right {
		transform: translate(2px, -2px);
	}
	@media (max-width: 600px) {
		.hero-meta {
			bottom: 24px;
			font-size: 0.85rem;
		}
	}
	.hero .container {
		width: 100%;
	}
	.hero-inner {
		text-align: center;
	}
	.greeting {
		font-family: var(--font-sans);
		font-weight: 300;
		letter-spacing: 0.01em;
		font-size: clamp(1.4rem, 3vw, 1.9rem);
		color: var(--muted);
		margin: 0 0 6px;
	}
	.rotator {
		display: grid;
		max-width: 30ch;
		margin: 0 auto;
		font-family: var(--font-serif);
		font-weight: 400;
		font-size: clamp(2rem, 4.6vw, 3.2rem);
		line-height: 1.1;
		letter-spacing: -0.01em;
		font-variant-numeric: lining-nums;
	}
	.rotator span {
		grid-area: 1 / 1;
		align-self: start;
		opacity: 0;
		transform: translateY(12px);
		transition:
			opacity 0.6s ease,
			transform 0.6s ease;
	}
	.rotator span.is-active {
		opacity: 1;
		transform: none;
	}
	@media (prefers-reduced-motion: reduce) {
		.rotator span {
			transform: none;
			transition: none;
		}
	}
	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
	}
	/* "What I do" strip */
	.strengths {
		padding-block: 48px;
		border-bottom: 1px solid rgba(90, 50, 30, 0.08);
	}
	.strengths ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 32px;
	}
	.strengths li {
		display: flex;
		align-items: center;
		gap: 16px;
	}
	.badge {
		flex-shrink: 0;
		display: grid;
		place-items: center;
		width: 48px;
		height: 48px;
		border-radius: 8px;
		background: #fbede5;
		border: 1px solid rgba(200, 130, 95, 0.18);
		color: #b0694a;
	}
	.strengths h3 {
		margin: 0;
		font-size: 1.6rem;
		line-height: 1.15;
	}
	.strengths p {
		margin: 2px 0 0;
		color: var(--muted);
		line-height: 1.4;
	}
	@media (max-width: 820px) {
		.strengths ul {
			grid-template-columns: 1fr;
			gap: 24px;
		}
	}
	#work h2 {
		text-align: center;
	}
	/* Projects stack one per row */
	.grid {
		display: flex;
		flex-direction: column;
		gap: 24px;
	}
	/* A project with an interactive flow hero */
	.feature {
		margin-bottom: 24px;
	}
	.feature h3 {
		margin: 16px 0 8px;
		font-size: clamp(1.8rem, 3.6vw, 2.5rem);
		line-height: 1.15;
	}
	.feature > p {
		margin: 0;
		color: var(--muted);
		max-width: 62ch;
	}
	.feature h3 a {
		color: inherit;
		text-decoration: none;
	}
	.read-more {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		margin-top: 14px;
		color: var(--fg);
		text-underline-offset: 4px;
	}
	.read-more:hover {
		color: var(--accent);
	}
	.card {
		border-radius: 12px;
		padding: 20px;
	}
	.card h3 {
		margin: 0 0 8px;
		font-size: 1.6rem;
		line-height: 1.2;
	}
	.tags {
		list-style: none;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
	}
	.tags li {
		font-size: 0.8rem;
		color: var(--muted);
		border: 1px solid var(--border);
		border-radius: 999px;
		padding: 2px 10px;
	}
</style>
