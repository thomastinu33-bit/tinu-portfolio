---
import { base } from '../lib/base';
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import PasswordGate from '../components/PasswordGate.astro';
import { site, projects, principles, experience } from '../data/site';
import Mail from '@lucide/astro/icons/mail';
import MapPin from '@lucide/astro/icons/map-pin';
import ArrowUpRight from '@lucide/astro/icons/arrow-up-right';
import Ruler from '@lucide/astro/icons/ruler';
import MousePointerClick from '@lucide/astro/icons/mouse-pointer-click';
import Ear from '@lucide/astro/icons/ear';
import UsersRound from '@lucide/astro/icons/users-round';

const principleIcons = { build: MousePointerClick, team: UsersRound, craft: Ruler, improve: Ear };
---

<Layout>
	<section class="hero">
		<div class="container hero-inner">
			<h1 class="greeting">Hi, I'm {site.name}</h1>
			<!-- All lines share one grid cell, so the hero keeps the height of the longest line and never jumps. -->
			<p class="rotator" aria-hidden="true">
				{site.intro.map((line, i) => <span class:list={{ 'is-active': i === 0 }}>{line}</span>)}
			</p>
			<p class="sr-only">{site.intro.join('. ')}.</p>
		</div>
		<div id="contact" class="hero-meta nav-width">
			<div class="touch">
				<span class="meta-label">Get in touch</span>
				<a class="meta-link" href={`mailto:${site.email}`}>
					<Mail size={16} strokeWidth={1.75} aria-hidden="true" />
					{site.email}
				</a>
				<a class="meta-link" href={site.linkedin} target="_blank" rel="noopener">
					LinkedIn
					<ArrowUpRight size={16} strokeWidth={1.75} aria-hidden="true" />
				</a>
			</div>
			<div class="location">
				<span class="meta-label">Based in</span>
				<span class="meta-link">
					<MapPin size={16} strokeWidth={1.75} aria-hidden="true" />
					{site.location}
				</span>
			</div>
		</div>
	</section>

	<section id="how-i-work" class="nav-width">
		<h2>How I work</h2>
		<ul class="principles">
			{
				principles.map((pr) => {
					const Icon = principleIcons[pr.icon];
					return (
						<li>
							<span class="p-badge">
								<Icon size={20} strokeWidth={1.5} aria-hidden="true" />
							</span>
							<h3>{pr.title}</h3>
							<p>{pr.body}</p>
						</li>
					);
				})
			}
		</ul>
	</section>

	<!-- Everything below is private until the password is entered (see the script at the bottom). -->
	<div id="gate-sentinel" aria-hidden="true"></div>
	<div id="gated" class="gated">
	<section id="work" class="nav-width">
		<h2>Experience</h2>

		<ol class="timeline">
			{
				experience.map((job) => {
					const cards = job.projects
						.map((slug) => projects.find((p) => p.slug === slug))
						.filter((p): p is NonNullable<typeof p> => Boolean(p));
					return (
						<li class="job">
							<p class="job-when">{job.when}</p>
							<div class="rail" aria-hidden="true" />
							<div class="job-body">
								<p class="job-when-m">{job.when}</p>
								<h3>{job.company}</h3>
								<p class="role">{job.role}</p>
								<p class="job-summary">{job.summary}</p>
								{cards.length > 0 && (
									<ul class="cards">
										{cards.map((p) => (
											<li>
												<a class="card" href={`${base}/case-studies/${p.slug}/`}>
													<div class:list={['thumb', { bare: p.cover?.bare }]}>
														{p.cover && (
															<Image
																src={p.cover.image}
																alt={p.cover.alt}
																widths={[400, 700, 1000]}
																sizes="(max-width: 720px) 90vw, 320px"
															/>
														)}
													</div>
													<h4>{p.title}</h4>
													<span class="cta">
														Read the case study
														<ArrowUpRight size={16} strokeWidth={1.5} aria-hidden="true" />
													</span>
												</a>
											</li>
										))}
									</ul>
								)}
							</div>
						</li>
					);
				})
			}
		</ol>
	</section>

	<section id="about" class="nav-width">
		<h2>About</h2>
		<div class="about-panel">
			<div class="about-card">
				<p class="about-lead">{site.about.lead}</p>
				<div class="about-story">
					{site.about.story.map((para) => <p>{para}</p>)}
				</div>
			</div>
			<div class="about-photo">
				{
					site.about.photo ? (
						<Image
							src={site.about.photo.image}
							alt={site.about.photo.alt}
							widths={[600, 900, 1200]}
							sizes="(max-width: 860px) 100vw, 440px"
							style={`object-position: ${site.about.photo.position ?? 'center'}`}
						/>
					) : (
						<span class="photo-slot">Your photo goes here</span>
					)
				}
			</div>
		</div>
	</section>
	</div>

	<PasswordGate mode="scroll" />
</Layout>

<script>
	const lines = document.querySelectorAll<HTMLElement>('.rotator span');
	let current = 0;
	if (lines.length > 1) {
		setInterval(() => {
			lines[current].classList.remove('is-active');
			current = (current + 1) % lines.length;
			lines[current].classList.add('is-active');
		}, 4500);
	}
</script>

<style>
	section {
		padding-block: 48px;
	}
	/* Full-screen gradient intro; everything after it sits below the fold on white */
	.hero {
		min-height: 100vh;
		min-height: 100svh;
		display: flex;
		align-items: center;
		position: relative;
		padding: 112px 0 140px;
		background: var(--gradient);
	}
	/* Contact details pinned to the bottom corners of the first screen */
	.hero-meta {
		position: absolute;
		left: 0;
		right: 0;
		bottom: 36px;
		display: flex;
		justify-content: space-between;
		align-items: flex-end;
		gap: 16px;
		font-size: 0.95rem;
	}
	.touch {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 4px 20px;
	}
	.location {
		flex-shrink: 0;
		text-align: right;
		white-space: nowrap;
	}
	.meta-label {
		display: block;
		width: 100%;
		color: var(--muted);
		font-size: 0.75rem;
		text-transform: uppercase;
		letter-spacing: 0.12em;
	}
	.meta-link {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		color: var(--fg);
		text-decoration: none;
	}
	.meta-link svg {
		flex-shrink: 0;
		color: var(--muted);
		transition: color 0.15s, transform 0.15s;
	}
	a.meta-link:hover,
	a.meta-link:hover svg {
		color: var(--accent);
	}
	a.meta-link:hover svg.lucide-arrow-up-right {
		transform: translate(2px, -2px);
	}
	@media (max-width: 600px) {
		.hero-meta {
			bottom: max(24px, env(safe-area-inset-bottom));
			font-size: 0.85rem;
		}
		a.meta-link {
			padding-block: 10px;
		}
	}
	.hero .container {
		width: 100%;
	}
	.hero-inner {
		text-align: center;
	}
	.greeting {
		font-family: var(--font-sans);
		font-weight: 300;
		letter-spacing: 0.01em;
		font-size: clamp(1.4rem, 3vw, 1.9rem);
		color: var(--muted);
		margin: 0 0 6px;
	}
	.rotator {
		display: grid;
		max-width: 30ch;
		margin: 0 auto;
		font-family: var(--font-serif);
		font-weight: 400;
		font-size: clamp(2rem, 4.6vw, 3.2rem);
		line-height: 1.1;
		letter-spacing: -0.01em;
		font-variant-numeric: lining-nums;
	}
	.rotator span {
		grid-area: 1 / 1;
		align-self: start;
		opacity: 0;
		transform: translateY(12px);
		transition:
			opacity 0.6s ease,
			transform 0.6s ease;
	}
	.rotator span.is-active {
		opacity: 1;
		transform: none;
	}
	@media (prefers-reduced-motion: reduce) {
		.rotator span {
			transform: none;
			transition: none;
		}
	}
	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
	}
	.badge {
		flex-shrink: 0;
		display: grid;
		place-items: center;
		width: 48px;
		height: 48px;
		border-radius: 8px;
		background: #fbede5;
		border: 1px solid rgba(200, 130, 95, 0.18);
		color: #b0694a;
	}
	#work h2 {
		text-align: center;
	}
	#gate-sentinel {
		height: 0;
	}
	/* How I work */
	#how-i-work h2 {
		text-align: center;
		margin-bottom: 28px;
	}
	.principles {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 16px;
	}
	.principles li {
		padding: clamp(20px, 3vw, 30px);
		border-radius: 20px;
		background: #f6f6f6;
		border: 1px solid #ececec;
	}
	.p-badge {
		display: grid;
		place-items: center;
		width: 44px;
		height: 44px;
		margin-bottom: 16px;
		border-radius: 8px;
		background: #fff;
		border: 1px solid #e3e3e3;
		color: #555;
	}
	.principles h3 {
		margin: 0 0 8px;
		font-size: clamp(1.4rem, 2.4vw, 1.8rem);
		line-height: 1.2;
	}
	.principles p {
		margin: 0;
		color: var(--muted);
		line-height: 1.55;
	}
	@media (max-width: 720px) {
		.principles {
			grid-template-columns: 1fr;
		}
	}

	/* About: a text card beside a photo, inside one soft panel */
	#about h2 {
		text-align: center;
		margin-bottom: 24px;
	}
	.about-panel {
		display: grid;
		grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
		gap: clamp(10px, 1.6vw, 16px);
		padding: clamp(10px, 1.6vw, 16px);
		border-radius: 28px;
		background: #f4f4f4;
		border: 1px solid #ececec;
	}
	.about-card {
		padding: clamp(22px, 3.6vw, 44px);
		border-radius: 20px;
		background: #fff;
		border: 1px solid #ececec;
	}
	.about-lead {
		margin: 0;
		font-family: var(--font-serif);
		font-size: clamp(1.45rem, 2.6vw, 1.9rem);
		line-height: 1.3;
		letter-spacing: -0.01em;
		font-variant-numeric: lining-nums;
	}
	.about-story {
		margin-top: 22px;
		padding-top: 24px;
		border-top: 1px solid #ececec;
		display: grid;
		gap: 14px;
	}
	.about-story p {
		margin: 0;
		font-size: 1rem;
		line-height: 1.65;
		color: var(--fg);
	}
	.about-photo {
		position: relative;
		overflow: hidden;
		border-radius: 20px;
		min-height: 320px;
		background: #ebebeb;
	}
	.about-photo :global(img) {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	.photo-slot {
		position: absolute;
		inset: 0;
		display: grid;
		place-items: center;
		color: var(--muted);
		font-size: 0.9rem;
		border: 1.5px dashed #cfcfcf;
		border-radius: 20px;
	}
	@media (max-width: 860px) {
		.about-panel {
			grid-template-columns: 1fr;
		}
		.about-photo {
			order: -1;
			min-height: 0;
			aspect-ratio: 4 / 3;
		}
	}

	/* Experience: a timeline, newest first. Each job has a few lines about the work and a card per case study. */
	.timeline {
		list-style: none;
		margin: 32px 0 0;
		padding: 0;
	}
	.job {
		display: grid;
		grid-template-columns: 150px 28px minmax(0, 1fr);
		column-gap: 20px;
	}
	.job-when {
		margin: 6px 0 0;
		text-align: right;
		font-size: 0.9rem;
		color: var(--muted);
		font-variant-numeric: lining-nums;
	}
	.job-when-m {
		display: none;
	}
	.rail {
		position: relative;
	}
	.rail::before {
		content: '';
		position: absolute;
		left: 50%;
		top: 18px;
		bottom: -2px;
		width: 1px;
		background: #dcdcdc;
		transform: translateX(-50%);
	}
	.rail::after {
		content: '';
		position: absolute;
		left: 50%;
		top: 10px;
		width: 11px;
		height: 11px;
		border-radius: 50%;
		background: #fff;
		border: 2px solid var(--fg);
		transform: translateX(-50%);
	}
	.job:last-child .rail::before {
		display: none;
	}
	.job-body {
		padding-bottom: 56px;
	}
	.job-body h3 {
		margin: 0;
		font-size: clamp(1.7rem, 3vw, 2.2rem);
		line-height: 1.15;
	}
	.role {
		margin: 4px 0 0;
		color: var(--muted);
	}
	.job-summary {
		margin: 14px 0 0;
		max-width: 62ch;
		line-height: 1.6;
	}
	.cards {
		list-style: none;
		margin: 24px 0 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
		gap: 16px;
	}
	.card {
		display: flex;
		flex-direction: column;
		height: 100%;
		box-sizing: border-box;
		padding: 12px 12px 18px;
		border-radius: 20px;
		background: #f6f6f6;
		border: 1px solid #ececec;
		color: inherit;
		text-decoration: none;
		transition:
			transform 0.3s ease,
			box-shadow 0.3s ease;
	}
	.card:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 4px;
	}
	.thumb {
		aspect-ratio: 16 / 10;
		overflow: hidden;
		border-radius: 12px;
		background: #fff;
		border: 1px solid #ececec;
	}
	.thumb :global(img) {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: top left;
		transition: transform 0.6s cubic-bezier(0.2, 0.7, 0.2, 1);
	}
	/* A picture that is already a laptop mockup: show all of it, with some room around it */
	.thumb.bare :global(img) {
		object-fit: contain;
		object-position: center;
		padding: 6%;
		box-sizing: border-box;
	}
	.card h4 {
		margin: 16px 6px 0;
		font-family: var(--font-serif);
		font-weight: 400;
		font-size: 1.25rem;
		line-height: 1.2;
	}
	.cta {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		align-self: flex-start;
		margin: auto 6px 0;
		padding-top: 16px;
		font-size: 0.92rem;
		transition: gap 0.3s;
	}
	@media (hover: hover) {
		.card:hover {
			transform: translateY(-4px);
			box-shadow: 0 18px 36px -18px rgba(0, 0, 0, 0.22);
		}
		.card:hover .thumb :global(img) {
			transform: scale(1.04);
		}
		.card:hover .cta {
			gap: 10px;
		}
	}
	@media (max-width: 820px) {
		.job {
			grid-template-columns: 20px minmax(0, 1fr);
			column-gap: 14px;
		}
		.job-when {
			display: none;
		}
		.job-when-m {
			display: block;
			margin: 0 0 6px;
			font-size: 0.85rem;
			color: var(--muted);
		}
		.job-body {
			grid-column: 2;
			grid-row: 1;
			padding-bottom: 44px;
		}
		.rail {
			grid-column: 1;
			grid-row: 1;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.card,
		.thumb :global(img),
		.cta {
			transition: none;
		}
	}
</style>
