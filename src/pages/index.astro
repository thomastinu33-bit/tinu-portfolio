---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import Lock from '@lucide/astro/icons/lock';
import { site, projects, strengths } from '../data/site';
import Mail from '@lucide/astro/icons/mail';
import MapPin from '@lucide/astro/icons/map-pin';
import ArrowUpRight from '@lucide/astro/icons/arrow-up-right';
import Component from '@lucide/astro/icons/component';
import MousePointerClick from '@lucide/astro/icons/mouse-pointer-click';
import ScanSearch from '@lucide/astro/icons/scan-search';

const base = import.meta.env.BASE_URL;
const [featured, ...others] = projects;
const strengthIcons = { component: Component, prototype: MousePointerClick, research: ScanSearch };
---

<Layout>
	<section class="hero">
		<div class="container hero-inner">
			<h1 class="greeting">Hi, I'm {site.name}</h1>
			<!-- All lines share one grid cell, so the hero keeps the height of the longest line and never jumps. -->
			<p class="rotator" aria-hidden="true">
				{site.intro.map((line, i) => <span class:list={{ 'is-active': i === 0 }}>{line}</span>)}
			</p>
			<p class="sr-only">{site.intro.join('. ')}.</p>
		</div>
		<div id="contact" class="hero-meta nav-width">
			<div class="touch">
				<span class="meta-label">Get in touch</span>
				<a class="meta-link" href={`mailto:${site.email}`}>
					<Mail size={16} strokeWidth={1.75} aria-hidden="true" />
					{site.email}
				</a>
				<a class="meta-link" href={site.linkedin} target="_blank" rel="noopener">
					LinkedIn
					<ArrowUpRight size={16} strokeWidth={1.75} aria-hidden="true" />
				</a>
			</div>
			<div class="location">
				<span class="meta-label">Based in</span>
				<span class="meta-link">
					<MapPin size={16} strokeWidth={1.75} aria-hidden="true" />
					{site.location}
				</span>
			</div>
		</div>
	</section>

	<section class="strengths nav-width" aria-label="What I do">
		<ul>
			{
				strengths.map((s) => {
					const Icon = strengthIcons[s.icon];
					return (
						<li>
							<span class="badge">
								<Icon size={20} strokeWidth={1.5} aria-hidden="true" />
							</span>
							<div>
								<h3>{s.title}</h3>
								<p>{s.note}</p>
							</div>
						</li>
					);
				})
			}
		</ul>
	</section>

	<!-- Everything below the strip is private until the password is entered (see the script at the bottom). -->
	<div id="gate-sentinel" aria-hidden="true"></div>
	<script is:inline>
		try {
			if (localStorage.getItem('portfolio-unlocked') === '1') document.documentElement.classList.add('pw-unlocked');
		} catch (e) {}
	</script>
	<div id="gated" class="gated">
	<section id="work" class="nav-width">
		<h2>Case Studies</h2>

		{
			featured && (
				<a class="featured" href={featured.slug ? `${base}/case-studies/${featured.slug}/` : undefined}>
					<div class="featured-text">
						<p class="eyebrow">Featured · {featured.tags[0]}</p>
						<h3>{featured.title}</h3>
						{featured.highlights && (
							<ul class="highlights">
								{featured.highlights.map((h) => (
									<li>{h}</li>
								))}
							</ul>
						)}
						<span class="cta">
							Read the case study
							<ArrowUpRight size={18} strokeWidth={1.5} aria-hidden="true" />
						</span>
					</div>
					<div class="featured-media">
						{featured.cover && (
							<div class="window">
								<div class="chrome" aria-hidden="true">
									<span />
									<span />
									<span />
								</div>
								<Image
									src={featured.cover.image}
									alt={featured.cover.alt}
									widths={[800, 1200, 1600]}
									sizes="(max-width: 900px) 100vw, 620px"
								/>
							</div>
						)}
					</div>
				</a>
			)
		}

		{
			others.length > 0 && (
				<>
					<p class="eyebrow more">More case studies</p>
					<div class="grid">
						{others.map((p) => {
							const href = p.slug ? `${base}/case-studies/${p.slug}/` : undefined;
							const Card = href ? 'a' : 'div';
							return (
								<Card class:list={['tile', { 'is-link': !!href }]} href={href}>
									<div class="tile-media">
										{p.cover ? (
											<Image
												src={p.cover.image}
												alt={p.cover.alt}
												widths={[600, 900, 1200]}
												sizes="(max-width: 700px) 100vw, 330px"
											/>
										) : (
											<span class="soon">Image coming soon</span>
										)}
									</div>
									<h3>{p.title}</h3>
									<p>{p.summary}</p>
								</Card>
							);
						})}
					</div>
				</>
			)
		}
	</section>

	<div class="container">
		<section id="about">
			<h2>About</h2>
			<p>{site.about}</p>
		</section>
	</div>
	</div>

	<dialog id="gate" class="gate" aria-labelledby="gate-title">
		<form id="gate-form" autocomplete="off">
			<span class="gate-icon"><Lock size={20} strokeWidth={1.75} aria-hidden="true" /></span>
			<h2 id="gate-title">This work is private</h2>
			<p class="gate-note">Enter the password to see the case studies and more.</p>
			<label class="sr-only" for="gate-input">Password</label>
			<input id="gate-input" type="password" placeholder="Password" autocomplete="off" required />
			<p id="gate-error" class="gate-error" role="alert" hidden>That password isn’t right. Try again.</p>
			<button type="submit" class="gate-submit">Unlock</button>
			<button type="button" id="gate-back" class="gate-back">Back to top</button>
		</form>
	</dialog>
</Layout>

<script>
	// A soft password gate: the content below the strip stays blurred and inert until the right password
	// is entered. Only a salted SHA-256 hash of the password lives here, not the password itself.
	// This keeps casual visitors out; it is not real security (the page's content is still in its HTML).
	const SALT = 'tinu-portfolio::';
	const HASH = '40b39b73b83ef876d85a9b09e934491c937d612581d22cd28b1d281d37893455';
	const STORE = 'portfolio-unlocked';

	const root = document.documentElement;
	const gated = document.getElementById('gated')!;
	const sentinel = document.getElementById('gate-sentinel')!;
	const dialog = document.getElementById('gate') as HTMLDialogElement;
	const form = document.getElementById('gate-form') as HTMLFormElement;
	const input = document.getElementById('gate-input') as HTMLInputElement;
	const error = document.getElementById('gate-error')!;

	const sha256 = async (text: string) => {
		const bytes = await crypto.subtle.digest('SHA-256', new TextEncoder().encode(SALT + text));
		return [...new Uint8Array(bytes)].map((b) => b.toString(16).padStart(2, '0')).join('');
	};

	let armed = true; // false right after "Back to top", until the visitor is above the trigger again
	const triggerLine = () => innerHeight * 0.7;

	if (!root.classList.contains('pw-unlocked')) {
		gated.setAttribute('inert', '');
		const check = () => {
			if (root.classList.contains('pw-unlocked')) return;
			const top = sentinel.getBoundingClientRect().top;
			if (top >= triggerLine()) armed = true;
			else if (armed && !dialog.open) openGate();
		};
		const openGate = () => {
			dialog.showModal();
			root.style.overflow = 'hidden';
			input.focus();
		};
		const closeGate = () => {
			dialog.close();
			root.style.overflow = '';
		};

		addEventListener('scroll', check, { passive: true });
		addEventListener('resize', check);
		check();

		// Esc must not skip the gate; "Back to top" is the way out
		dialog.addEventListener('cancel', (e) => e.preventDefault());

		document.getElementById('gate-back')!.addEventListener('click', () => {
			armed = false;
			closeGate();
			scrollTo({ top: 0, behavior: 'smooth' });
		});

		form.addEventListener('submit', async (e) => {
			e.preventDefault();
			let ok = false;
			try {
				ok = (await sha256(input.value)) === HASH;
			} catch {
				error.textContent = 'This browser can’t check the password here.';
			}
			if (ok) {
				root.classList.add('pw-unlocked');
				gated.removeAttribute('inert');
				try {
					localStorage.setItem(STORE, '1');
				} catch {}
				closeGate();
			} else {
				if (!error.textContent?.includes('browser')) error.textContent = 'That password isn’t right. Try again.';
				error.hidden = false;
				dialog.classList.remove('shake');
				void dialog.offsetWidth; // restart the animation
				dialog.classList.add('shake');
				input.select();
			}
		});
	}
</script>

<script>
	const lines = document.querySelectorAll<HTMLElement>('.rotator span');
	let current = 0;
	if (lines.length > 1) {
		setInterval(() => {
			lines[current].classList.remove('is-active');
			current = (current + 1) % lines.length;
			lines[current].classList.add('is-active');
		}, 4500);
	}
</script>

<style>
	section {
		padding-block: 48px;
	}
	/* Full-screen gradient intro; everything after it sits below the fold on white */
	.hero {
		min-height: 100vh;
		min-height: 100svh;
		display: flex;
		align-items: center;
		position: relative;
		padding: 112px 0 140px;
		background: var(--gradient);
	}
	/* Contact details pinned to the bottom corners of the first screen */
	.hero-meta {
		position: absolute;
		left: 0;
		right: 0;
		bottom: 36px;
		display: flex;
		justify-content: space-between;
		align-items: flex-end;
		gap: 16px;
		font-size: 0.95rem;
	}
	.touch {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 4px 20px;
	}
	.location {
		flex-shrink: 0;
		text-align: right;
		white-space: nowrap;
	}
	.meta-label {
		display: block;
		width: 100%;
		color: var(--muted);
		font-size: 0.75rem;
		text-transform: uppercase;
		letter-spacing: 0.12em;
	}
	.meta-link {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		color: var(--fg);
		text-decoration: none;
	}
	.meta-link svg {
		flex-shrink: 0;
		color: var(--muted);
		transition: color 0.15s, transform 0.15s;
	}
	a.meta-link:hover,
	a.meta-link:hover svg {
		color: var(--accent);
	}
	a.meta-link:hover svg.lucide-arrow-up-right {
		transform: translate(2px, -2px);
	}
	@media (max-width: 600px) {
		.hero-meta {
			bottom: 24px;
			font-size: 0.85rem;
		}
	}
	.hero .container {
		width: 100%;
	}
	.hero-inner {
		text-align: center;
	}
	.greeting {
		font-family: var(--font-sans);
		font-weight: 300;
		letter-spacing: 0.01em;
		font-size: clamp(1.4rem, 3vw, 1.9rem);
		color: var(--muted);
		margin: 0 0 6px;
	}
	.rotator {
		display: grid;
		max-width: 30ch;
		margin: 0 auto;
		font-family: var(--font-serif);
		font-weight: 400;
		font-size: clamp(2rem, 4.6vw, 3.2rem);
		line-height: 1.1;
		letter-spacing: -0.01em;
		font-variant-numeric: lining-nums;
	}
	.rotator span {
		grid-area: 1 / 1;
		align-self: start;
		opacity: 0;
		transform: translateY(12px);
		transition:
			opacity 0.6s ease,
			transform 0.6s ease;
	}
	.rotator span.is-active {
		opacity: 1;
		transform: none;
	}
	@media (prefers-reduced-motion: reduce) {
		.rotator span {
			transform: none;
			transition: none;
		}
	}
	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
	}
	/* "What I do" strip */
	.strengths {
		padding-block: 48px;
		border-bottom: 1px solid rgba(90, 50, 30, 0.08);
	}
	.strengths ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 32px;
	}
	.strengths li {
		display: flex;
		align-items: center;
		gap: 16px;
	}
	.badge {
		flex-shrink: 0;
		display: grid;
		place-items: center;
		width: 48px;
		height: 48px;
		border-radius: 8px;
		background: #fbede5;
		border: 1px solid rgba(200, 130, 95, 0.18);
		color: #b0694a;
	}
	.strengths h3 {
		margin: 0;
		font-size: 1.6rem;
		line-height: 1.15;
	}
	.strengths p {
		margin: 2px 0 0;
		color: var(--muted);
		line-height: 1.4;
	}
	@media (max-width: 820px) {
		.strengths ul {
			grid-template-columns: 1fr;
			gap: 24px;
		}
	}
	#work h2 {
		text-align: center;
	}
	/* The private part of the page */
	.gated {
		transition: filter 0.6s ease;
	}
	:global(html:not(.pw-unlocked)) .gated {
		filter: blur(14px);
		pointer-events: none;
		user-select: none;
	}
	:global(html) {
		scrollbar-gutter: stable;
	}
	#gate-sentinel {
		height: 0;
	}
	.gate {
		width: min(420px, calc(100vw - 32px));
		padding: 32px;
		border: 1px solid #e3e3e3;
		border-radius: 24px;
		background: #fff;
		color: var(--fg);
		box-shadow: 0 30px 80px rgba(0, 0, 0, 0.16);
	}
	.gate::backdrop {
		background: rgba(255, 255, 255, 0.4);
		-webkit-backdrop-filter: blur(6px);
		backdrop-filter: blur(6px);
	}
	.gate form {
		display: grid;
		gap: 14px;
		justify-items: start;
	}
	.gate-icon {
		display: grid;
		place-items: center;
		width: 44px;
		height: 44px;
		border-radius: 12px;
		background: #efefef;
		color: #555;
	}
	.gate h2 {
		margin: 4px 0 0;
		font-size: 1.9rem;
		line-height: 1.15;
	}
	.gate-note {
		margin: 0;
		color: var(--muted);
	}
	.gate input {
		box-sizing: border-box;
		width: 100%;
		height: 46px;
		padding: 0 14px;
		border: 1px solid #d6d6d6;
		border-radius: 12px;
		font: inherit;
		font-size: 1rem;
		color: var(--fg);
		background: #fff;
	}
	.gate input:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 2px;
	}
	.gate-error {
		margin: -4px 0 0;
		font-size: 0.9rem;
		color: #b3261e;
	}
	.gate-submit {
		all: unset;
		box-sizing: border-box;
		width: 100%;
		height: 46px;
		display: grid;
		place-items: center;
		border-radius: 999px;
		background: #2b2b2b;
		color: #fff;
		cursor: pointer;
		transition: background 0.2s;
	}
	.gate-submit:hover {
		background: #000;
	}
	.gate-submit:focus-visible,
	.gate-back:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 2px;
	}
	.gate-back {
		all: unset;
		cursor: pointer;
		color: var(--muted);
		font-size: 0.9rem;
		text-decoration: underline;
		text-underline-offset: 4px;
	}
	.gate-back:hover {
		color: var(--fg);
	}
	.shake {
		animation: shake 0.4s;
	}
	@keyframes shake {
		20%,
		60% {
			transform: translateX(-6px);
		}
		40%,
		80% {
			transform: translateX(6px);
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.shake {
			animation: none;
		}
		.gated {
			transition: none;
		}
	}

	/* Case studies: one featured panel (short text, big picture), then a row of image-first tiles */
	.eyebrow {
		margin: 0;
		font-size: 0.75rem;
		text-transform: uppercase;
		letter-spacing: 0.14em;
		color: var(--muted);
	}
	.featured {
		display: grid;
		grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
		gap: clamp(24px, 4vw, 56px);
		align-items: center;
		margin-top: 24px;
		padding: clamp(20px, 4vw, 48px);
		border-radius: 24px;
		background: #f6f6f6;
		border: 1px solid #ececec;
		color: inherit;
		text-decoration: none;
	}
	.featured:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 6px;
	}
	.featured h3 {
		margin: 14px 0 0;
		font-size: clamp(1.7rem, 3vw, 2.3rem);
		line-height: 1.15;
	}
	.highlights {
		list-style: none;
		margin: 22px 0 0;
		padding: 0;
		display: grid;
		gap: 8px;
		color: var(--muted);
	}
	.highlights li {
		display: flex;
		gap: 10px;
	}
	.highlights li::before {
		content: '–';
		color: var(--fg);
	}
	.cta {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		margin-top: 26px;
		padding-bottom: 3px;
		border-bottom: 1.5px solid var(--fg);
		transition:
			gap 0.3s,
			border-color 0.3s;
	}
	.featured:hover .cta,
	.featured:focus-visible .cta {
		gap: 10px;
	}
	.featured-media {
		display: grid;
		place-items: center;
		overflow: hidden;
		padding: clamp(14px, 2.4vw, 28px);
		border-radius: 18px;
		background: #fff;
		border: 1px solid #ececec;
	}
	.window {
		width: 100%;
		border-radius: 12px;
		overflow: hidden;
		background: #fff;
		border: 1px solid #e3e3e3;
		box-shadow:
			0 24px 50px -20px rgba(0, 0, 0, 0.18),
			0 8px 20px rgba(0, 0, 0, 0.06);
		transition:
			transform 0.7s cubic-bezier(0.2, 0.7, 0.2, 1),
			box-shadow 0.7s ease;
	}
	.window :global(img) {
		display: block;
		width: 100%;
		height: auto;
	}
	.chrome {
		display: flex;
		gap: 6px;
		padding: 9px 12px;
		background: #f3f3f3;
		border-bottom: 1px solid rgba(0, 0, 0, 0.06);
	}
	.chrome span {
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background: #d9d9d9;
	}
	@media (hover: hover) {
		.featured:hover .window,
		.featured:focus-visible .window {
			transform: scale(1.06);
			box-shadow:
				0 34px 70px -24px rgba(0, 0, 0, 0.28),
				0 12px 28px rgba(0, 0, 0, 0.08);
		}
	}
	.more {
		margin-top: 56px;
	}
	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
		gap: 28px;
		margin-top: 18px;
	}
	.tile {
		display: block;
		color: inherit;
		text-decoration: none;
	}
	.tile:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 6px;
		border-radius: 18px;
	}
	.tile-media {
		display: grid;
		place-items: center;
		aspect-ratio: 16 / 10;
		overflow: hidden;
		border-radius: 16px;
		background: #f6f6f6;
		border: 1px solid #ececec;
	}
	.tile-media :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.7s cubic-bezier(0.2, 0.7, 0.2, 1);
	}
	@media (hover: hover) {
		.tile.is-link:hover .tile-media :global(img) {
			transform: scale(1.06);
		}
	}
	.soon {
		color: var(--muted);
		font-size: 0.9rem;
	}
	.tile h3 {
		margin: 16px 0 6px;
		font-size: 1.45rem;
		line-height: 1.2;
	}
	.tile p {
		margin: 0;
		color: var(--muted);
		font-size: 0.95rem;
		line-height: 1.5;
	}
	@media (max-width: 820px) {
		.featured {
			grid-template-columns: 1fr;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.window,
		.tile-media :global(img),
		.cta {
			transition: none;
		}
	}
</style>
