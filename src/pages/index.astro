---
import Layout from '../layouts/Layout.astro';
import { site, projects } from '../data/site';
---

<Layout>
	<section class="hero">
		<div class="container hero-inner">
			<h1 class="greeting">Hi, I'm {site.name}</h1>
			<!-- All lines share one grid cell, so the hero keeps the height of the longest line and never jumps. -->
			<p class="rotator" aria-hidden="true">
				{site.intro.map((line, i) => <span class:list={{ 'is-active': i === 0 }}>{line}</span>)}
			</p>
			<p class="sr-only">{site.intro.join('. ')}.</p>
		</div>
	</section>

	<div class="container">
		<section id="work">
			<h2>Case Studies</h2>
			<div class="grid">
				{
					projects.map((p) => (
						<article class="card glass">
							<h3>{p.href ? <a href={p.href}>{p.title}</a> : p.title}</h3>
							<p>{p.summary}</p>
							<ul class="tags">
								{p.tags.map((t) => (
									<li>{t}</li>
								))}
							</ul>
						</article>
					))
				}
			</div>
		</section>

		<section id="about">
			<h2>About</h2>
			<p>{site.about}</p>
		</section>
	</div>
</Layout>

<script>
	const lines = document.querySelectorAll<HTMLElement>('.rotator span');
	let current = 0;
	if (lines.length > 1) {
		setInterval(() => {
			lines[current].classList.remove('is-active');
			current = (current + 1) % lines.length;
			lines[current].classList.add('is-active');
		}, 3200);
	}
</script>

<style>
	section {
		padding: 48px 0;
	}
	/* Full-screen gradient intro; everything after it sits below the fold on white */
	.hero {
		min-height: 100vh;
		min-height: 100svh;
		display: flex;
		align-items: center;
		padding: 112px 0 48px;
		background: var(--gradient);
	}
	.hero .container {
		width: 100%;
	}
	.hero-inner {
		text-align: center;
	}
	.greeting {
		font-weight: 300;
		font-size: clamp(1.4rem, 3vw, 1.9rem);
		color: var(--muted);
		margin: 0 0 6px;
	}
	.rotator {
		display: grid;
		max-width: 22ch;
		margin: 0 auto;
		font-weight: 600;
		font-size: clamp(1.9rem, 5vw, 3.2rem);
		line-height: 1.2;
		letter-spacing: -0.01em;
	}
	.rotator span {
		grid-area: 1 / 1;
		align-self: start;
		opacity: 0;
		transform: translateY(12px);
		transition:
			opacity 0.6s ease,
			transform 0.6s ease;
	}
	.rotator span.is-active {
		opacity: 1;
		transform: none;
	}
	@media (prefers-reduced-motion: reduce) {
		.rotator span {
			transform: none;
			transition: none;
		}
	}
	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
	}
	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
		gap: 20px;
	}
	.card {
		border-radius: 12px;
		padding: 20px;
	}
	.card h3 {
		margin-top: 0;
		font-weight: 500;
	}
	.tags {
		list-style: none;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
	}
	.tags li {
		font-size: 0.8rem;
		color: var(--muted);
		border: 1px solid var(--border);
		border-radius: 999px;
		padding: 2px 10px;
	}
</style>
