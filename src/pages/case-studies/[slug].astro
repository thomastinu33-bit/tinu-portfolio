---
import { Image } from 'astro:assets';
import { base } from '../../lib/base';
import Icon from '../../components/Icon.astro';
import Layout from '../../layouts/Layout.astro';
import PasswordGate from '../../components/PasswordGate.astro';
import { site } from '../../data/site';
import { studies } from '../../data/studies';
import { studyImage } from '../../lib/studyImages';

export function getStaticPaths() {
	return studies.map((study) => ({ params: { slug: study.slug }, props: { study } }));
}

const { study } = Astro.props;
---
<Layout title={`${study.title} · ${site.name}`} description={study.summary}>
	<div id="gated" class="gated">
	<div class="wash" aria-hidden="true"></div>
	<article class="container study">
		<a class="back" href={`${base}/#work`}>← Experience</a>

		<ul class="tags">
			{study.tags.map((t) => <li>{t}</li>)}
		</ul>
		<h1>{study.title}</h1>
		<p class="lead">{study.summary}</p>
		<hr class="rule" />
		{
			study.hero && (
				<figure class="hero-shot">
					<Image src={studyImage(study.cover.src)} alt={study.cover.alt} widths={[700, 1100, 1600]} sizes="(max-width: 940px) 100vw, 900px" />
				</figure>
			)
		}

		<div class="blocks">
			{
				study.blocks.map((b) => {
					switch (b.type) {
						case 'heading':
							return <h2>{b.text}</h2>;
						case 'text':
							return <p class="text">{b.text}</p>;
						case 'list':
							return (
								<ul class="list">
									{b.items.map((i) => (
										<li>{i}</li>
									))}
								</ul>
							);
						case 'image':
							return (
								<figure>
									<Image src={studyImage(b.src)} alt={b.alt} widths={[700, 1100, 1600]} sizes="(max-width: 940px) 100vw, 900px" />
									{b.caption && <figcaption>{b.caption}</figcaption>}
								</figure>
							);
						case 'row':
							return (
								<figure>
									<div class="row" style={`--n: ${b.images.length}`}>
										{b.images.map((im) => (
											<Image src={studyImage(im.src)} alt={im.alt} widths={[400, 700, 1000]} sizes="(max-width: 940px) 50vw, 300px" />
										))}
									</div>
									{b.caption && <figcaption>{b.caption}</figcaption>}
								</figure>
							);
						case 'logos':
							return (
								<div class="logos">
									{b.images.map((im) => (
										<Image src={studyImage(im.src)} alt={im.alt} widths={[300, 600]} sizes="240px" />
									))}
								</div>
							);
						case 'stats':
							return (
								<dl class="stats">
									{b.items.map((i) => (
										<div>
											<dt>{i.value}</dt>
											<dd>{i.label}</dd>
										</div>
									))}
								</dl>
							);
						case 'research':
							return (
								<div class="research">
									<section class="panel">
										<h3>{b.questionsLabel}</h3>
										<ul class="asks">
											{b.questions.map((q) => (
												<li>{`\u201c${q}\u201d`}</li>
											))}
										</ul>
									</section>
									<section class="panel">
										<h3>{b.painLabel}</h3>
										<ul class="pains">
											{b.pains.map((t) => (
												<li>{t}</li>
											))}
										</ul>
									</section>
								</div>
							);
						case 'personas':
							return (
								<div class="personas">
									{b.items.map((p) => (
										<section class="persona">
											<span class="persona-label">{p.label}</span>
											<span class="persona-icon">
												<Icon name={p.icon} size={30} weight="light" />
											</span>
											<h3>{p.title}</h3>
											<p>{p.body}</p>
										</section>
									))}
								</div>
							);
						case 'video':
							return (
								<figure class="clip-wrap">
									<div class="clip-box">
										<video
											class="clip"
											src={`${base}/${b.src}`}
											poster={`${base}/${b.poster}`}
											muted
											loop
											playsinline
											preload="metadata"
											aria-label={b.caption ?? 'Walkthrough video'}
										/>
										<div class="clip-ctrls">
											<button class="clip-toggle" type="button" aria-label="Pause video">
												<Icon name="pause" size={18} weight="fill" class="i-pause" />
												<Icon name="play" size={18} weight="fill" class="i-play" />
											</button>
											<button class="clip-full" type="button" aria-label="View full screen">
												<Icon name="arrows-out-simple" size={18} weight="bold" class="i-enter" />
												<Icon name="arrows-in-simple" size={18} weight="bold" class="i-exit" />
											</button>
										</div>
									</div>
									{b.caption && <figcaption>{b.caption}</figcaption>}
								</figure>
							);
						case 'quotes':
							return (
								<div class="quotes">
									{b.items.map((q) => (
										<blockquote>{q}</blockquote>
									))}
								</div>
							);
					}
				})
			}
		</div>
	</article>
	</div>

	<PasswordGate mode="immediate" />
</Layout>

<script>
	// Clips play while on screen and pause when off screen. The corner button (or a click on the clip) pauses and plays.
	const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
	document.querySelectorAll<HTMLElement>('.clip-box').forEach((box) => {
		const v = box.querySelector('video')!;
		const btn = box.querySelector<HTMLButtonElement>('.clip-toggle')!;
		const full = box.querySelector<HTMLButtonElement>('.clip-full')!;
		let userPaused = still;
		const sync = () => {
			box.classList.toggle('is-paused', v.paused);
			btn.setAttribute('aria-label', v.paused ? 'Play video' : 'Pause video');
		};
		v.addEventListener('play', sync);
		v.addEventListener('pause', sync);
		const toggle = () => {
			userPaused = !v.paused;
			v.paused ? v.play().catch(() => {}) : v.pause();
		};
		btn.addEventListener('click', toggle);
		const vid = v as HTMLVideoElement & { webkitEnterFullscreen?: () => void };
		full.addEventListener('click', () => {
			if (document.fullscreenElement) document.exitFullscreen();
			else if (box.requestFullscreen) box.requestFullscreen().catch(() => {});
			else vid.webkitEnterFullscreen?.(); // iPhone Safari only fullscreens the video itself
			if (v.paused && !userPaused) v.play().catch(() => {});
		});
		document.addEventListener('fullscreenchange', () => {
			const on = document.fullscreenElement === box;
			box.classList.toggle('is-full', on);
			full.setAttribute('aria-label', on ? 'Exit full screen' : 'View full screen');
		});
		v.addEventListener('click', toggle);
		new IntersectionObserver(([e]) => {
			if (e.isIntersecting && !userPaused) v.play().catch(() => {});
			else if (!e.isIntersecting) v.pause();
		}, { threshold: 0.4 }).observe(box);
		sync();
	});
</script>

<style>
	/* Soft colour behind the top of the page, like the landing page */
	.wash {
		position: absolute;
		inset: 0 0 auto;
		height: 720px;
		z-index: -1;
		pointer-events: none;
		overflow: hidden;
		background:
			radial-gradient(42% 55% at 12% 12%, rgba(255, 214, 190, 0.6), transparent 70%),
			radial-gradient(40% 55% at 88% 8%, rgba(214, 205, 255, 0.55), transparent 70%);
		filter: blur(18px);
		-webkit-mask-image: linear-gradient(#000 60%, transparent);
		mask-image: linear-gradient(#000 60%, transparent);
	}
	.gated {
		position: relative;
		isolation: isolate;
	}
	.study {
		max-width: 940px;
		padding-top: 130px;
		padding-bottom: 40px;
	}
	.back {
		display: inline-block;
		color: var(--muted);
		text-decoration: none;
		margin-bottom: 32px;
		font-size: 0.95rem;
		transition: color 0.2s ease;
	}
	.back:hover {
		color: var(--fg);
	}
	h1 {
		font-family: var(--font-serif);
		font-weight: 400;
		font-size: clamp(2.3rem, 5.4vw, 3.6rem);
		line-height: 1.08;
		letter-spacing: -0.015em;
		margin: 20px 0 16px;
		max-width: 22ch;
	}
	.lead {
		max-width: 72ch;
		font-size: 1.2rem;
		line-height: 1.6;
		color: var(--muted);
		margin: 0;
	}
	.rule {
		border: 0;
		height: 1px;
		margin: 40px 0 0;
		background: linear-gradient(90deg, rgba(90, 50, 30, 0.14), transparent);
	}
	.tags {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-wrap: wrap;
		gap: 4px 0;
		font-size: 0.76rem;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--muted);
	}
	.tags li + li::before {
		content: '·';
		margin: 0 10px;
	}
	.hero-shot {
		margin-top: 40px;
	}
	.hero-shot :global(img) {
		border: 0;
		background: none;
		box-shadow: none;
	}
	.blocks {
		display: grid;
		gap: 28px;
		margin-top: 40px;
	}
	.blocks h2 {
		margin: 40px 0 -10px;
		font-size: clamp(1.7rem, 3vw, 2.2rem);
	}
	.blocks h2:first-child {
		margin-top: 0;
	}
	.text,
	.list {
		max-width: 80ch;
		margin: 0;
		font-size: 1.1rem;
		line-height: 1.7;
		color: #3d3d3d;
	}
	.list {
		padding-left: 1.2em;
		display: grid;
		gap: 8px;
	}
	figure {
		margin: 0;
	}
	/* Pictures sit on a soft glass frame */
	figure :global(img) {
		display: block;
		width: 100%;
		height: auto;
		border-radius: 20px;
		background: #f6f4f2;
		border: 1px solid rgba(255, 255, 255, 0.9);
		box-shadow: 0 24px 60px -24px rgba(120, 90, 140, 0.3);
	}
	figcaption {
		margin-top: 12px;
		max-width: 80ch;
		font-size: 0.92rem;
		line-height: 1.55;
		color: var(--muted);
	}
	.clip {
		display: block;
		width: 100%;
		height: auto;
		border-radius: 20px;
		border: 1px solid #ececec;
		background: #fff;
		box-shadow: 0 24px 60px -24px rgba(0, 0, 0, 0.25);
		cursor: pointer;
	}
	.clip-box {
		position: relative;
	}
	.clip-ctrls {
		position: absolute;
		right: 14px;
		bottom: 14px;
		display: flex;
		gap: 8px;
	}
	.clip-toggle,
	.clip-full {
		display: grid;
		place-items: center;
		width: 40px;
		height: 40px;
		padding: 0;
		border-radius: 999px;
		color: var(--fg);
		cursor: pointer;
		background: rgba(255, 255, 255, 0.6);
		border: 1px solid rgba(255, 255, 255, 0.8);
		-webkit-backdrop-filter: blur(14px) saturate(160%);
		backdrop-filter: blur(14px) saturate(160%);
		box-shadow: 0 6px 18px -6px rgba(0, 0, 0, 0.25);
		transition: background 0.2s ease, transform 0.2s ease;
	}
	.clip-toggle:hover,
	.clip-full:hover {
		background: rgba(255, 255, 255, 0.9);
		transform: scale(1.06);
	}
	.clip-toggle :global(svg),
	.clip-full :global(svg) {
		grid-area: 1 / 1;
	}
	.clip-toggle :global(.i-play),
	.is-paused .clip-toggle :global(.i-pause) {
		display: none;
	}
	.is-paused .clip-toggle :global(.i-play) {
		display: block;
	}
	.clip-full :global(.i-exit),
	.is-full .clip-full :global(.i-enter) {
		display: none;
	}
	.is-full .clip-full :global(.i-exit) {
		display: block;
	}
	.clip-box:fullscreen {
		display: grid;
		place-items: center;
		background: #000;
	}
	.clip-box:fullscreen .clip {
		width: 100%;
		height: 100%;
		object-fit: contain;
		border: 0;
		border-radius: 0;
		box-shadow: none;
	}
	.row {
		display: grid;
		grid-template-columns: repeat(min(var(--n), 3), minmax(0, 1fr));
		gap: 14px;
	}
	.logos {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 24px 48px;
	}
	.logos :global(img) {
		height: 56px;
		width: auto;
	}
	/* Glass cards for numbers and quotes */
	.stats {
		margin: 0;
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 16px;
	}
	.stats div,
	blockquote {
		border-radius: 24px;
		background: linear-gradient(140deg, rgba(255, 255, 255, 0.85) 0%, rgba(255, 247, 242, 0.45) 100%);
		border: 1px solid rgba(255, 255, 255, 0.9);
		-webkit-backdrop-filter: blur(20px) saturate(160%);
		backdrop-filter: blur(20px) saturate(160%);
		box-shadow:
			inset 0 1px 0 #fff,
			0 18px 44px -20px rgba(140, 110, 170, 0.25);
		transition: transform 0.3s cubic-bezier(0.2, 0.7, 0.2, 1), box-shadow 0.3s ease;
	}
	.stats div:hover,
	blockquote:hover {
		transform: translateY(-4px);
		box-shadow:
			inset 0 1px 0 #fff,
			0 26px 54px -20px rgba(150, 110, 170, 0.35);
	}
	.stats div {
		padding: 26px 26px 24px;
		background: #fafafa;
		border-color: #ececec;
		box-shadow: 0 12px 30px -18px rgba(0, 0, 0, 0.15);
	}
	.stats dt {
		font-family: var(--font-serif);
		font-size: clamp(2.2rem, 4.4vw, 3.1rem);
		line-height: 1;
		letter-spacing: -0.01em;
	}
	.stats dd {
		margin: 10px 0 0;
		color: var(--muted);
		font-size: 0.95rem;
		line-height: 1.45;
	}
	/* Discovery: questions on the left, pain points on the right, on two quiet panels */
	.research {
		display: grid;
		grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
		gap: 16px;
	}
	.panel {
		display: flex;
		flex-direction: column;
		padding: 28px;
		border-radius: 28px;
		background: #fafafa;
		border: 1px solid #ececec;
	}
	.panel h3 {
		margin: 0 0 22px;
		font-family: var(--font-sans);
		font-weight: 400;
		font-size: 0.76rem;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--muted);
	}
	.asks,
	.pains {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.asks {
		flex: 1;
		display: flex;
		flex-direction: column;
	}
	/* the questions share the panel's height evenly, so both panels end on the same line */
	.asks li {
		flex: 1;
		display: flex;
		align-items: center;
		padding: 14px 0;
		font-family: var(--font-serif);
		font-size: 1.3rem;
		line-height: 1.35;
	}
	.asks li:first-child {
		padding-top: 0;
	}
	.asks li:last-child {
		padding-bottom: 0;
	}
	.pains {
		flex: 1;
		display: flex;
		flex-direction: column;
	}
	.pains li {
		flex: 1;
		display: flex;
		align-items: center;
		padding: 14px 0;
		font-size: 1rem;
		line-height: 1.55;
		color: #3d3d3d;
	}
	.pains li:first-child {
		padding-top: 0;
	}
	.pains li:last-child {
		padding-bottom: 0;
	}
	.asks li + li,
	.pains li + li {
		border-top: 1px solid #ececec;
	}
	.personas {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 16px;
	}
	.persona {
		position: relative;
		overflow: hidden;
		padding: 28px 28px 30px;
		border-radius: 24px;
		background: #fff;
		border: 1px solid #ececec;
		box-shadow: 0 12px 30px -20px rgba(0, 0, 0, 0.18);
		transition: transform 0.3s cubic-bezier(0.2, 0.7, 0.2, 1), box-shadow 0.3s ease;
	}
	/* a soft peach and lavender glow in the corner of each card */
	.persona::before {
		content: '';
		position: absolute;
		inset: -40% -30% auto auto;
		width: 75%;
		height: 80%;
		background: radial-gradient(closest-side, rgba(255, 214, 190, 0.55), transparent);
		pointer-events: none;
	}
	.persona:nth-child(2)::before {
		background: radial-gradient(closest-side, rgba(214, 205, 255, 0.55), transparent);
	}
	.persona:hover {
		transform: translateY(-4px);
		box-shadow: 0 22px 40px -18px rgba(255, 150, 100, 0.4);
	}
	.persona-label {
		position: relative;
		display: block;
		font-size: 0.74rem;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--muted);
	}
	.persona-icon {
		position: relative;
		display: grid;
		place-items: center;
		width: 64px;
		height: 64px;
		margin: 22px 0 28px;
		border-radius: 18px;
		color: var(--fg);
		background: rgba(255, 255, 255, 0.7);
		border: 1px solid rgba(255, 255, 255, 0.95);
		-webkit-backdrop-filter: blur(14px) saturate(160%);
		backdrop-filter: blur(14px) saturate(160%);
		box-shadow: inset 0 1px 0 #fff, 0 10px 24px -12px rgba(120, 90, 140, 0.35);
	}
	.persona h3 {
		position: relative;
		margin: 0 0 10px;
		font-size: 1.7rem;
		line-height: 1.15;
	}
	.persona p {
		position: relative;
		margin: 0;
		font-size: 1.02rem;
		line-height: 1.6;
		color: #3d3d3d;
	}
	.quotes {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 16px;
	}
	blockquote {
		margin: 0;
		padding: 28px;
		font-family: var(--font-serif);
		font-size: 1.3rem;
		line-height: 1.4;
	}
	@media (max-width: 860px) {
		.research {
			grid-template-columns: 1fr;
		}
	}
	@media (max-width: 720px) {
		.panel {
			padding: 22px;
		}
		.study {
			padding-top: 110px;
		}
		.stats,
		.personas,
		.quotes {
			grid-template-columns: 1fr;
		}
		.row {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
		.logos :global(img) {
			height: 44px;
		}
	}
	@media (prefers-reduced-motion: reduce), (hover: none) {
		.stats div:hover,
		.persona:hover,
		blockquote:hover {
			transform: none;
		}
	}
</style>
