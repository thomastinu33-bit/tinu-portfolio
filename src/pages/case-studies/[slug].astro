---
import { Image } from 'astro:assets';
import { base } from '../../lib/base';
import Layout from '../../layouts/Layout.astro';
import PasswordGate from '../../components/PasswordGate.astro';
import { site } from '../../data/site';
import { studies } from '../../data/studies';
import { studyImage } from '../../lib/studyImages';

export function getStaticPaths() {
	return studies.map((study) => ({ params: { slug: study.slug }, props: { study } }));
}

const { study } = Astro.props;
---
<Layout title={`${study.title} · ${site.name}`} description={study.summary}>
	<div id="gated" class="gated">
	<div class="wash" aria-hidden="true"></div>
	<article class="container study">
		<a class="back" href={`${base}/#work`}>← Experience</a>

		<ul class="tags">
			{study.tags.map((t) => <li>{t}</li>)}
		</ul>
		<h1>{study.title}</h1>
		<p class="lead">{study.summary}</p>
		<hr class="rule" />
		{
			study.hero && (
				<figure class="hero-shot">
					<Image src={studyImage(study.cover.src)} alt={study.cover.alt} widths={[700, 1100, 1600]} sizes="(max-width: 940px) 100vw, 900px" />
				</figure>
			)
		}

		<div class="blocks">
			{
				study.blocks.map((b) => {
					switch (b.type) {
						case 'heading':
							return <h2>{b.text}</h2>;
						case 'text':
							return <p class="text">{b.text}</p>;
						case 'list':
							return (
								<ul class="list">
									{b.items.map((i) => (
										<li>{i}</li>
									))}
								</ul>
							);
						case 'image':
							return (
								<figure>
									<Image src={studyImage(b.src)} alt={b.alt} widths={[700, 1100, 1600]} sizes="(max-width: 940px) 100vw, 900px" />
									{b.caption && <figcaption>{b.caption}</figcaption>}
								</figure>
							);
						case 'row':
							return (
								<figure>
									<div class="row" style={`--n: ${b.images.length}`}>
										{b.images.map((im) => (
											<Image src={studyImage(im.src)} alt={im.alt} widths={[400, 700, 1000]} sizes="(max-width: 940px) 50vw, 300px" />
										))}
									</div>
									{b.caption && <figcaption>{b.caption}</figcaption>}
								</figure>
							);
						case 'logos':
							return (
								<div class="logos">
									{b.images.map((im) => (
										<Image src={studyImage(im.src)} alt={im.alt} widths={[300, 600]} sizes="240px" />
									))}
								</div>
							);
						case 'stats':
							return (
								<dl class="stats">
									{b.items.map((i) => (
										<div>
											<dt>{i.value}</dt>
											<dd>{i.label}</dd>
										</div>
									))}
								</dl>
							);
						case 'quotes':
							return (
								<div class="quotes">
									{b.items.map((q) => (
										<blockquote>{q}</blockquote>
									))}
								</div>
							);
					}
				})
			}
		</div>
	</article>
	</div>

	<PasswordGate mode="immediate" />
</Layout>

<style>
	/* Soft colour behind the top of the page, like the landing page */
	.wash {
		position: absolute;
		inset: 0 0 auto;
		height: 720px;
		z-index: -1;
		pointer-events: none;
		overflow: hidden;
		background:
			radial-gradient(42% 55% at 12% 12%, rgba(255, 214, 190, 0.6), transparent 70%),
			radial-gradient(40% 55% at 88% 8%, rgba(214, 205, 255, 0.55), transparent 70%);
		filter: blur(18px);
		-webkit-mask-image: linear-gradient(#000 60%, transparent);
		mask-image: linear-gradient(#000 60%, transparent);
	}
	.gated {
		position: relative;
		isolation: isolate;
	}
	.study {
		max-width: 940px;
		padding-top: 130px;
		padding-bottom: 40px;
	}
	.back {
		display: inline-block;
		color: var(--muted);
		text-decoration: none;
		margin-bottom: 32px;
		font-size: 0.95rem;
		transition: color 0.2s ease;
	}
	.back:hover {
		color: var(--fg);
	}
	h1 {
		font-family: var(--font-serif);
		font-weight: 400;
		font-size: clamp(2.3rem, 5.4vw, 3.6rem);
		line-height: 1.08;
		letter-spacing: -0.015em;
		margin: 20px 0 16px;
		max-width: 22ch;
	}
	.lead {
		max-width: 60ch;
		font-size: 1.2rem;
		line-height: 1.6;
		color: var(--muted);
		margin: 0;
	}
	.rule {
		border: 0;
		height: 1px;
		margin: 40px 0 0;
		background: linear-gradient(90deg, rgba(90, 50, 30, 0.14), transparent);
	}
	.tags {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-wrap: wrap;
		gap: 4px 0;
		font-size: 0.76rem;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--muted);
	}
	.tags li + li::before {
		content: '·';
		margin: 0 10px;
	}
	.hero-shot {
		margin-top: 40px;
	}
	.hero-shot :global(img) {
		border: 0;
		background: none;
		box-shadow: none;
	}
	.blocks {
		display: grid;
		gap: 28px;
		margin-top: 40px;
	}
	.blocks h2 {
		margin: 40px 0 -10px;
		font-size: clamp(1.7rem, 3vw, 2.2rem);
	}
	.blocks h2:first-child {
		margin-top: 0;
	}
	.text,
	.list {
		max-width: 62ch;
		margin: 0;
		font-size: 1.1rem;
		line-height: 1.7;
		color: #3d3d3d;
	}
	.list {
		padding-left: 1.2em;
		display: grid;
		gap: 8px;
	}
	figure {
		margin: 0;
	}
	/* Pictures sit on a soft glass frame */
	figure :global(img) {
		display: block;
		width: 100%;
		height: auto;
		border-radius: 20px;
		background: #f6f4f2;
		border: 1px solid rgba(255, 255, 255, 0.9);
		box-shadow: 0 24px 60px -24px rgba(120, 90, 140, 0.3);
	}
	figcaption {
		margin-top: 12px;
		max-width: 62ch;
		font-size: 0.92rem;
		line-height: 1.55;
		color: var(--muted);
	}
	.row {
		display: grid;
		grid-template-columns: repeat(min(var(--n), 3), minmax(0, 1fr));
		gap: 14px;
	}
	.logos {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 24px 48px;
	}
	.logos :global(img) {
		height: 56px;
		width: auto;
	}
	/* Glass cards for numbers and quotes */
	.stats {
		margin: 0;
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 16px;
	}
	.stats div,
	blockquote {
		border-radius: 24px;
		background: linear-gradient(140deg, rgba(255, 255, 255, 0.85) 0%, rgba(255, 247, 242, 0.45) 100%);
		border: 1px solid rgba(255, 255, 255, 0.9);
		-webkit-backdrop-filter: blur(20px) saturate(160%);
		backdrop-filter: blur(20px) saturate(160%);
		box-shadow:
			inset 0 1px 0 #fff,
			0 18px 44px -20px rgba(140, 110, 170, 0.25);
		transition: transform 0.3s cubic-bezier(0.2, 0.7, 0.2, 1), box-shadow 0.3s ease;
	}
	.stats div:hover,
	blockquote:hover {
		transform: translateY(-4px);
		box-shadow:
			inset 0 1px 0 #fff,
			0 26px 54px -20px rgba(150, 110, 170, 0.35);
	}
	.stats div {
		padding: 26px 26px 24px;
		background: #fafafa;
		border-color: #ececec;
		box-shadow: 0 12px 30px -18px rgba(0, 0, 0, 0.15);
	}
	.stats dt {
		font-family: var(--font-serif);
		font-size: clamp(2.2rem, 4.4vw, 3.1rem);
		line-height: 1;
		letter-spacing: -0.01em;
	}
	.stats dd {
		margin: 10px 0 0;
		color: var(--muted);
		font-size: 0.95rem;
		line-height: 1.45;
	}
	.quotes {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 16px;
	}
	blockquote {
		margin: 0;
		padding: 28px;
		font-family: var(--font-serif);
		font-size: 1.3rem;
		line-height: 1.4;
	}
	@media (max-width: 720px) {
		.study {
			padding-top: 110px;
		}
		.stats,
		.quotes {
			grid-template-columns: 1fr;
		}
		.row {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
		.logos :global(img) {
			height: 44px;
		}
	}
	@media (prefers-reduced-motion: reduce), (hover: none) {
		.stats div:hover,
		blockquote:hover,
	}
</style>
