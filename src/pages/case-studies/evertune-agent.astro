---
import { base } from '../../lib/base';
import Layout from '../../layouts/Layout.astro';
import PasswordGate from '../../components/PasswordGate.astro';
import { site, projects } from '../../data/site';

const project = projects.find((p) => p.slug === 'evertune-agent')!;
---
<Layout title={`${project.title} · ${site.name}`} description={project.summary}>
	<div id="gated" class="gated">
	<article class="container study">
		<a class="back" href={`${base}/#work`}>← All case studies</a>

		<ul class="tags">
			{project.tags.map((t) => <li>{t}</li>)}
		</ul>
		<h1>{project.title}</h1>

		<section>
			<h2>Overview</h2>
			<p>
				Evertune’s platform covers two areas: GEO, which measures and improves how a brand shows up in AI
				answers, and Ads. The goal of this project was to create one unified agent experience across both.
			</p>
			<p>
				Customers should be able to ask questions about how their visibility is doing, create GEO strategies
				and build ad campaigns from a single place, without the agent feeling complex or overwhelming to use.
			</p>
		</section>
	</article>
	</div>

	<PasswordGate mode="immediate" />
</Layout>

<style>
	.study {
		max-width: 900px;
		padding-top: 140px;
		padding-bottom: 80px;
	}
	.back {
		display: inline-block;
		color: var(--muted);
		text-decoration: none;
		margin-bottom: 28px;
	}
	.back:hover {
		color: var(--accent);
	}
	h1 {
		font-family: var(--font-serif);
		font-weight: 400;
		font-size: clamp(2.2rem, 5vw, 3.4rem);
		line-height: 1.1;
		letter-spacing: -0.01em;
		margin: 16px 0 12px;
	}
	section {
		margin-top: 56px;
	}
	section p {
		max-width: 62ch;
		font-size: 1.1rem;
		color: var(--fg);
	}
	.tags {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
	}
	.tags li {
		font-size: 0.8rem;
		color: var(--muted);
		border: 1px solid #e3e3e3;
		border-radius: 999px;
		padding: 2px 10px;
	}
</style>
