---
import Layout from '../../layouts/Layout.astro';
import PasswordGate from '../../components/PasswordGate.astro';
import { Image } from 'astro:assets';
import { site, projects } from '../../data/site';
import AffinityBoard from '../../components/AffinityBoard.astro';
import UserFlow from '../../components/UserFlow.astro';
import DesignSystem from '../../components/DesignSystem.astro';
import homepageShot from '../../assets/yd/homepage.png';
import metricsShot from '../../assets/yd/metrics.png';
import reportShot from '../../assets/yd/report.png';

const project = projects.find((p) => p.slug === 'yipitdata')!;
const base = import.meta.env.BASE_URL;

const stats = [
	{ value: '97%', label: 'User adoption' },
	{ value: '2x', label: 'User engagement' },
	{ value: '72%', label: 'Retention' },
];

const problems = [
	{
		title: 'Discoverability of existing content',
		question: 'How might we make it easy for customers to quickly find the content they are looking for?',
	},
	{
		title: 'Ability to deep-dive',
		question:
			'How might we empower our users to do their own deep-dive analysis from our platform and data offerings?',
	},
	{
		title: 'Personalization and customization',
		question: 'How might we make it easy for customers to focus on what matters to them most?',
	},
	{
		title: 'Streamlining updates and preserving context',
		question:
			'How might we quickly update customers on new changes and enable seamless transitions from key findings to deep dives, preserving their context?',
	},
];

const experiences = [
	{
		title: 'Homepage',
		text: 'The homepage design made it easy for customers to quickly find the content they needed, resulting in a 12x increase in daily visitors.',
		shot: homepageShot,
		alt: 'The YipitData homepage: recently published reports, recently viewed products and trending products.',
	},
	{
		title: 'Key metrics screener',
		text: 'Customers were thrilled with the key metrics screener, which let them effortlessly track essential KPIs for the companies they cared about. The feature led to a 73% week-over-week retention rate.',
		shot: metricsShot,
		alt: 'The key metrics screener: a table of metrics from the watchlist with trailing days, estimates and more.',
	},
	{
		title: 'Reading a report',
		text: 'Previously, customers, especially new ones, struggled to find key content within a report. The new design added report outlines, adaptive zoom and links to specific sections that can be shared with peers in an organization, making reading more intuitive and collaborative.',
		shot: reportShot,
		alt: 'Reading a report: an outline of sections beside the report, with tools to share a link, print and zoom.',
	},
];

const quotes = [
	{
		before: 'Visiting the platform now is a ',
		mark: 'force of habit',
		after: '. When my browser opens, Yipit opens with it.',
	},
	{
		before: 'I think I use it more actually. It’s just ',
		mark: 'more inviting',
		after: '. It just looks better and the layout seems easily digestible. Whereas before it was a little bit archaic.',
	},
];
---

<Layout title={`${project.title} · ${site.name}`} description={project.summary}>
	<div id="gated" class="gated">
		<article class="container study">
			<a class="back" href={`${base}/#work`}>← All case studies</a>

			<ul class="tags">
				{project.tags.map((t) => <li>{t}</li>)}
			</ul>
			<h1>{project.title}</h1>

			<figure class="hero">
				<Image
					src={project.cover!.image}
					alt={project.cover!.alt}
					widths={[800, 1200, 1600]}
					sizes="(max-width: 960px) 100vw, 900px"
					loading="eager"
				/>
			</figure>

			<section>
				<h2>Context</h2>
				<p>
					YipitData is a fast-growing leader in alternative data, turning non-traditional data sources into
					actionable insights for institutional investors and businesses. In 2021, the company secured a $475
					million investment from Carlyle Group.
				</p>
				<p>
					At the time, the service was delivered mainly by email, which posed security risks and showed early
					signs of potential data-sharing concerns. I was hired to address this by encouraging customers to
					adopt the Investor Platform, where they could securely access reports and dashboards through a
					streamlined web experience.
				</p>
			</section>

			<section>
				<h2>My role</h2>
				<p>
					I led the end-to-end design process to move YipitData’s service from email-based delivery to a web
					platform, building the experience from 0 to 1.
				</p>
				<ul class="stats">
					{
						stats.map((s) => (
							<li>
								<span class="value">{s.value}</span>
								<span class="label">{s.label}</span>
							</li>
						))
					}
				</ul>
			</section>

			<section>
				<h2>Understanding customers</h2>
				<p>
					Design and Product had little precedent for working with customers directly. Recognizing the value
					of real feedback, I spent three months reviewing recorded calls, identifying pain points and mapping
					insights with my PM. We worked with revenue teams to reach customers and hear from them directly,
					creating research artifacts like affinity maps and user flow diagrams so the designs stayed aligned
					with customer needs.
				</p>
				<AffinityBoard />
				<p class="bridge">
					The affinity maps showed what customers cared about: finding content, going deeper into the data, and
					focusing on the names that mattered to them. To see how that played out in practice, I mapped user flows
					from the moment they received an email, through signing in, to digging into the data.
				</p>
				<p class="bridge">
					Mapping each path made it easier to see where the platform could meet those needs. I also used the flows
					to ask how each feature would help different kinds of users.
				</p>
				<UserFlow />
				<p class="figcap">One of the user flow diagrams, from onboarding to digging into the data.</p>
			</section>

			<section>
				<h2>Problems to solve</h2>
				<p>Four problems came out of that research.</p>
				<ol class="problems">
					{
						problems.map((p, i) => (
							<li>
								<span class="n">{i + 1}</span>
								<div>
									<h3>{p.title}</h3>
									<p>{p.question}</p>
								</div>
							</li>
						))
					}
				</ol>
			</section>

			<section>
				<h2>Creating the design system</h2>
				<p>
					I built a design system for the investor platform, creating components and managing tokens. A design
					system streamlines handoff by removing the need to annotate every component for engineers, which
					made it an invaluable part of the workflow.
				</p>
				<p>
					One challenge during implementation was how the components behaved. Engineers used MUI, and its
					defaults didn’t fully match the design: the colors were too bright, and interactions relied on
					clicks where the design leaned on hover. To resolve this, certain components and their behavior were
					redefined, which cut down on repetitive annotation during handoff.
				</p>
				<DesignSystem />
			</section>

			<section>
				<h2>Evolving the platform experience</h2>
				<p>
					By building on what I learned about customers and working closely with PMs and engineers, I
					improved how customers used the platform: a seamless web experience that gave them a professional,
					modern way to work with YipitData.
				</p>
				<div class="experiences">
					{
						experiences.map((e) => (
							<div class="experience">
								<figure class="screen">
									<div class="bar" aria-hidden="true">
										<span />
										<span />
										<span />
									</div>
									<Image src={e.shot} alt={e.alt} widths={[800, 1200, 1600]} sizes="(max-width: 960px) 100vw, 900px" />
								</figure>
								<div class="copy">
									<h3>{e.title}</h3>
									<p>{e.text}</p>
								</div>
							</div>
						))
					}
				</div>
				<p>
					I also worked closely with engineers on a responsive version, so the platform works well on a phone
					for customers on the go.
				</p>
			</section>

			<section>
				<h2>What customers said</h2>
				<div class="voices">
					{
						quotes.map((q) => (
							<figure class="voice">
								<span class="mark-big" aria-hidden="true">“</span>
								<blockquote>
									{q.before}
									<mark>{q.mark}</mark>
									{q.after}
								</blockquote>
								<figcaption>YipitData customer</figcaption>
							</figure>
						))
					}
				</div>
			</section>
		</article>
	</div>

	<PasswordGate mode="immediate" />
</Layout>

<style>
	.study {
		max-width: 900px;
		padding-top: 140px;
		padding-bottom: 40px;
	}
	.back {
		display: inline-block;
		color: var(--muted);
		text-decoration: none;
		margin-bottom: 28px;
	}
	.back:hover {
		color: var(--accent);
	}
	h1 {
		font-family: var(--font-serif);
		font-weight: 400;
		font-size: clamp(2.2rem, 5vw, 3.4rem);
		line-height: 1.1;
		letter-spacing: -0.01em;
		margin: 16px 0 12px;
	}
	.tags {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
	}
	.tags li {
		font-size: 0.8rem;
		color: var(--muted);
		border: 1px solid #e3e3e3;
		border-radius: 999px;
		padding: 2px 10px;
	}
	.hero {
		margin: 32px 0 0;
		overflow: hidden;
		border-radius: 20px;
		border: 1px solid #ececec;
		background: #0e3340;
	}
	.hero :global(img) {
		display: block;
		width: 100%;
		height: auto;
	}
	section {
		margin-top: 56px;
	}
	section p {
		max-width: 62ch;
		font-size: 1.1rem;
		color: var(--fg);
	}
	.stats {
		list-style: none;
		margin: 28px 0 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 16px;
	}
	.stats li {
		display: grid;
		gap: 4px;
		padding: 22px 24px;
		border-radius: 16px;
		background: #f6f6f6;
		border: 1px solid #ececec;
	}
	.value {
		font-family: var(--font-serif);
		font-variant-numeric: lining-nums;
		font-size: clamp(2.2rem, 5vw, 3.2rem);
		line-height: 1;
		color: var(--fg);
	}
	.label {
		color: var(--muted);
		font-size: 0.95rem;
	}
	section p.figcap {
		margin: 12px 0 0;
		color: var(--muted);
		font-size: 0.9rem;
	}
	/* Product screens in a plain window frame on the site's own neutral panel */
	.screen {
		margin: 0;
		overflow: hidden;
		border-radius: 14px;
		background: #fff;
		border: 1px solid #e3e3e3;
		box-shadow:
			0 24px 50px -22px rgba(0, 0, 0, 0.18),
			0 8px 20px rgba(0, 0, 0, 0.05);
	}
	.screen .bar {
		display: flex;
		gap: 6px;
		padding: 9px 12px;
		background: #f3f3f3;
		border-bottom: 1px solid rgba(0, 0, 0, 0.06);
	}
	.screen .bar span {
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background: #d9d9d9;
	}
	.screen :global(img) {
		display: block;
		width: 100%;
		height: auto;
	}
	.slots {
		display: grid;
		gap: 16px;
		margin-top: 28px;
	}
	.slots.two {
		grid-template-columns: repeat(2, 1fr);
	}
	/* Dashed placeholder for an image that is not in yet */
	.slot {
		margin: 0;
		display: grid;
		place-items: center;
		aspect-ratio: 16 / 10;
		border: 1.5px dashed #cfcfcf;
		border-radius: 16px;
		background: #fafafa;
		color: var(--muted);
		font-size: 0.9rem;
		text-align: center;
		padding: 12px;
	}
	.slot.wide {
		aspect-ratio: 16 / 9;
	}
	.problems {
		list-style: none;
		margin: 24px 0 0;
		padding: 0;
		display: grid;
		gap: 12px;
		grid-template-columns: repeat(2, 1fr);
	}
	.problems li {
		display: flex;
		gap: 14px;
		padding: 20px;
		border-radius: 16px;
		background: #f6f6f6;
		border: 1px solid #ececec;
	}
	.n {
		flex-shrink: 0;
		display: grid;
		place-items: center;
		width: 28px;
		height: 28px;
		border-radius: 8px;
		background: #fff;
		border: 1px solid #e3e3e3;
		color: #555;
		font-size: 0.85rem;
		font-weight: 500;
	}
	.problems h3 {
		margin: 0 0 6px;
		font-size: 1.35rem;
		line-height: 1.2;
	}
	.problems p {
		margin: 0;
		font-size: 0.98rem;
		color: var(--muted);
	}
	.experiences {
		display: grid;
		gap: 44px;
		margin: 28px 0;
	}
	.experience {
		display: grid;
		gap: 16px;
	}
	.experience h3 {
		margin: 0 0 6px;
		font-size: 1.6rem;
		line-height: 1.2;
	}
	.experience p {
		margin: 0;
		color: var(--muted);
	}
	/* Customer voices: two equal quotes side by side */
	.voices {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 16px;
		margin-top: 28px;
	}
	.voice {
		margin: 0;
		display: flex;
		flex-direction: column;
		padding: clamp(22px, 3.4vw, 36px);
		border-radius: 20px;
		background: #fbfbfb;
		border: 1px solid #ececec;
	}
	.mark-big {
		display: block;
		font-family: var(--font-serif);
		font-size: 5rem;
		line-height: 0.6;
		height: 0.35em;
		color: #d9d9d9;
	}
	.voice blockquote {
		margin: 0;
		flex: 1;
		font-family: var(--font-serif);
		font-weight: 400;
		font-size: clamp(1.5rem, 2.6vw, 2rem);
		line-height: 1.25;
		letter-spacing: -0.01em;
	}
	/* A soft highlighter stroke under the phrase that matters */
	.voice mark {
		background: linear-gradient(transparent 62%, #e4e4e4 62%);
		color: inherit;
		padding: 0 2px;
	}
	.voice figcaption {
		display: flex;
		align-items: center;
		gap: 10px;
		margin-top: 22px;
		font-family: var(--font-sans);
		font-size: 0.82rem;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--muted);
	}
	.voice figcaption::before {
		content: '';
		width: 22px;
		height: 1px;
		background: #bdbdbd;
	}
	@media (max-width: 720px) {
		.stats,
		.slots.two,
		.voices,
		.problems {
			grid-template-columns: 1fr;
		}
	}
</style>
