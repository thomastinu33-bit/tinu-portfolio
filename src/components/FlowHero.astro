---
// A project hero: one screen in a window frame on a soft peach panel, with numbered steps
// underneath. Click a step to jump to it; it also advances on its own until someone clicks.
import { Image } from 'astro:assets';
import type { FlowStep } from '../data/site';

interface Props {
	steps: FlowStep[];
}

const { steps } = Astro.props;
---

<div class="flow" data-flow>
	<div class="panel">
		<div class="window">
			<div class="chrome" aria-hidden="true"><span></span><span></span><span></span></div>
			<div class="stage">
				{
					steps.map((step, i) => (
						<Image
							class:list={['shot', { 'is-active': i === 0 }]}
							src={step.image}
							alt={`${step.label}: ${step.caption}`}
							widths={[800, 1200, 1800]}
							sizes="(max-width: 1000px) 100vw, 900px"
							loading={i === 0 ? 'eager' : 'lazy'}
						/>
					))
				}
			</div>
		</div>
	</div>

	<ol class="steps" role="tablist" aria-label="Flow steps">
		{
			steps.map((step, i) => (
				<li>
					<button
						type="button"
						role="tab"
						class:list={{ 'is-active': i === 0 }}
						aria-selected={i === 0 ? 'true' : 'false'}
						data-step={i}
						data-caption={step.caption}
					>
						<span class="num">{i + 1}</span>
						<span class="label">{step.label}</span>
					</button>
				</li>
			))
		}
	</ol>
	<p class="caption" aria-live="polite">{steps[0].caption}</p>
</div>

<script>
	const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;

	document.querySelectorAll<HTMLElement>('[data-flow]').forEach((flow) => {
		const shots = flow.querySelectorAll<HTMLElement>('.shot');
		const tabs = flow.querySelectorAll<HTMLButtonElement>('[data-step]');
		const caption = flow.querySelector<HTMLElement>('.caption')!;
		let current = 0;
		let userTookOver = false;
		let timer: number | undefined;

		const show = (i: number) => {
			current = i;
			shots.forEach((el, n) => el.classList.toggle('is-active', n === i));
			tabs.forEach((el, n) => {
				el.classList.toggle('is-active', n === i);
				el.setAttribute('aria-selected', String(n === i));
			});
			caption.textContent = tabs[i].dataset.caption ?? '';
		};

		tabs.forEach((tab, i) => {
			tab.addEventListener('click', () => {
				userTookOver = true;
				window.clearInterval(timer);
				show(i);
			});
		});

		// Gentle auto-play while the hero is on screen, until the visitor clicks a step.
		const start = () => {
			if (reduceMotion || userTookOver || timer) return;
			timer = window.setInterval(() => show((current + 1) % shots.length), 4500);
		};
		const stop = () => {
			window.clearInterval(timer);
			timer = undefined;
		};
		new IntersectionObserver(
			([entry]) => (entry.isIntersecting ? start() : stop()),
			{ threshold: 0.5 },
		).observe(flow);
		flow.addEventListener('pointerenter', stop);
		flow.addEventListener('pointerleave', () => {
			if (!userTookOver) start();
		});
	});
</script>

<style>
	.flow {
		margin-top: 28px;
	}
	/* Soft peach backdrop, the same gradient as the intro */
	.panel {
		padding: clamp(16px, 4vw, 44px);
		border-radius: 20px;
		background: #f6f6f6;
		border: 1px solid #ececec;
	}
	.window {
		border-radius: 12px;
		overflow: hidden;
		background: #fff;
		border: 1px solid #e3e3e3;
		box-shadow:
			0 30px 60px -20px rgba(0, 0, 0, 0.18),
			0 8px 20px rgba(0, 0, 0, 0.06);
	}
	.chrome {
		display: flex;
		gap: 6px;
		padding: 10px 14px;
		background: #f3f3f3;
		border-bottom: 1px solid rgba(0, 0, 0, 0.06);
	}
	.chrome span {
		width: 9px;
		height: 9px;
		border-radius: 50%;
		background: #d9d9d9;
	}
	/* Every screen shares one cell, so switching never changes the height. */
	.stage {
		display: grid;
		aspect-ratio: 2880 / 1724;
	}
	.stage :global(.shot) {
		grid-area: 1 / 1;
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
		opacity: 0;
		transition: opacity 0.5s ease;
	}
	.stage :global(.shot.is-active) {
		opacity: 1;
	}
	.steps {
		list-style: none;
		margin: 24px 0 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
		gap: 10px;
	}
	.steps button {
		all: unset;
		box-sizing: border-box;
		width: 100%;
		display: flex;
		align-items: center;
		gap: 12px;
		padding: 10px 12px;
		border-radius: 10px;
		cursor: pointer;
		color: var(--muted);
		border: 1px solid transparent;
		transition:
			background 0.2s,
			color 0.2s,
			border-color 0.2s;
	}
	.steps button:hover {
		color: var(--fg);
	}
	.steps button:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 2px;
	}
	.num {
		flex-shrink: 0;
		display: grid;
		place-items: center;
		width: 30px;
		height: 30px;
		border-radius: 8px;
		font-size: 0.85rem;
		background: #efefef;
		color: #555;
		transition:
			background 0.2s,
			color 0.2s;
	}
	.label {
		font-size: 1rem;
	}
	.steps button.is-active {
		color: var(--fg);
		border-color: #e3e3e3;
		background: #fff;
		box-shadow: 0 4px 14px rgba(0, 0, 0, 0.06);
	}
	.steps button.is-active .num {
		background: #2b2b2b;
		color: #fff;
	}
	.caption {
		margin: 16px 0 0;
		min-height: 3em;
		text-align: center;
		color: var(--muted);
		max-width: 60ch;
		margin-inline: auto;
	}
	@media (max-width: 600px) {
		.steps {
			grid-template-columns: repeat(2, 1fr);
		}
	}
</style>
