---
// A compact snippet of the Investor Platform design system, drawn from its Figma documentation:
// the foundations that set it apart from MUI's defaults (color tokens, type) next to the custom,
// hover-driven filter. Colors with a hex value are the ones labeled in the Figma file.
import ListFilter from '@lucide/astro/icons/list-filter';
import X from '@lucide/astro/icons/x';
import ChevronRight from '@lucide/astro/icons/chevron-right';

const primary = [
	{ name: 'main', value: '#0D4753', css: '#0D4753' },
	{ name: 'dark', value: '#0C404B', css: '#0C404B' },
	{ name: 'light', value: '#255964', css: '#255964' },
];
const states = [
	{ name: 'hover', value: '10%', css: 'rgba(13, 71, 83, 0.10)' },
	{ name: 'selected', value: '15%', css: 'rgba(13, 71, 83, 0.15)' },
	{ name: 'focus', value: '20%', css: 'rgba(13, 71, 83, 0.20)' },
	{ name: 'outline', value: '30%', css: 'rgba(13, 71, 83, 0.30)' },
];
const text = [
	{ name: 'primary', value: '87%', css: 'rgba(0, 0, 0, 0.87)' },
	{ name: 'secondary', value: '60%', css: 'rgba(0, 0, 0, 0.60)' },
	{ name: 'tertiary', value: '#9E9E9E', css: '#9E9E9E' },
	{ name: 'disabled', value: '38%', css: 'rgba(0, 0, 0, 0.38)' },
];
const type = [
	{ name: 'Heading 1', size: 24, lh: '120%', weight: 700 },
	{ name: 'Heading 3', size: 16, lh: '140%', weight: 500 },
	{ name: 'Body', size: 14, lh: '140%', weight: 400 },
	{ name: 'Caption', size: 12, lh: '140%', weight: 400 },
];
const categories = ['APAC', 'Cloud', 'Consumer Goods', 'Consumer Services', 'E-Commerce', 'Financial Services', 'Media & Internet', 'MedTech', 'Software'];
const consumerGoods = [
	'Auto Parts',
	'Clothing & Apparel',
	'Electronics & Appliances',
	'Furniture',
	'Health & Beauty',
	'Home Improvement',
	'Pet Supplies',
	'Pool Supplies',
	'Sports Goods & Clothing',
	'Staples',
	'Toys',
	'Macro',
	'Restaurants',
];
---

<link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&display=swap" rel="stylesheet" />

<div class="ds">
	<header class="ds-head">
		<span class="mark">y</span>
		<div>
			<b>A snippet of the Investor Platform design system</b>
			<span>Roboto · 14px base</span>
		</div>
	</header>

	<div class="cols">
		<!-- Foundations -->
		<section class="col" aria-label="Color and type">
			<h4 class="title">Color</h4>
			<ul class="sw-row">
				{
					primary.map((c) => (
						<li>
							<span class="sw" style={`background:${c.css}`} />
							<b>{c.name}</b>
							<span>{c.value}</span>
						</li>
					))
				}
			</ul>
			<ul class="sw-row four">
				{
					states.map((c) => (
						<li>
							<span class="sw line short" style={`background:${c.css}`} />
							<b>{c.name}</b>
							<span>{c.value}</span>
						</li>
					))
				}
			</ul>
			<ul class="sw-row four">
				{
					text.map((c) => (
						<li>
							<span class="sw short" style={`background:${c.css}`} />
							<b>{c.name}</b>
							<span>{c.value}</span>
						</li>
					))
				}
			</ul>

			<h4 class="title spaced">Type</h4>
			<ul class="type">
				{
					type.map((t) => (
						<li>
							<span style={`font-size:${t.size}px; font-weight:${t.weight}; line-height:${t.lh}`}>{t.name}</span>
							<span class="spec">
								{t.size}px · {t.weight}
							</span>
						</li>
					))
				}
			</ul>
		</section>

		<!-- Filter -->
		<section class="col" aria-label="Custom filter">
			<h4 class="title">Filter <span>custom, since MUI has none</span></h4>
			<div class="states" aria-hidden="true">
				<span class="fchip"><ListFilter size={13} strokeWidth={1.75} />Filter</span>
				<span class="fchip is-hover"><ListFilter size={13} strokeWidth={1.75} />Filter</span>
				<span class="fchip is-selected"><ListFilter size={13} strokeWidth={1.75} />Filter: Unread <X size={12} strokeWidth={2} /></span>
			</div>

			<div class="try" data-filter>
				<p class="try-hint">Try it: hover Consumer Goods, then pick a category.</p>
				<span class="fchip live" data-chip>
					<ListFilter size={13} strokeWidth={1.75} aria-hidden="true" />
					<span data-chip-label>Filter</span>
					<button type="button" class="clear" data-clear aria-label="Clear the filter" hidden>
						<X size={12} strokeWidth={2} aria-hidden="true" />
					</button>
				</span>
				<div class="menus">
					<ul class="menu" role="menu" aria-label="Sectors">
						{
							categories.map((c) => (
								<li class:list={['mitem', { has: c === 'Consumer Goods' }]}>
									<button type="button" role="menuitem" aria-haspopup={c === 'Consumer Goods' ? 'true' : undefined}>
										{c}
										{c === 'Consumer Goods' && <ChevronRight size={14} strokeWidth={1.75} aria-hidden="true" />}
									</button>
									{c === 'Consumer Goods' && (
										<ul class="menu sub" role="menu" aria-label="Consumer Goods">
											{consumerGoods.map((g) => (
												<li>
													<button type="button" role="menuitemcheckbox" aria-checked="false" data-pick={g}>
														{g}
													</button>
												</li>
											))}
										</ul>
									)}
								</li>
							))
						}
					</ul>
				</div>
			</div>
		</section>
	</div>
</div>

<script>
	document.querySelectorAll<HTMLElement>('[data-filter]').forEach((root) => {
		const label = root.querySelector<HTMLElement>('[data-chip-label]')!;
		const chip = root.querySelector<HTMLElement>('[data-chip]')!;
		const clear = root.querySelector<HTMLButtonElement>('[data-clear]')!;
		const picks = [...root.querySelectorAll<HTMLButtonElement>('[data-pick]')];
		const selected: string[] = [];

		const render = () => {
			const n = selected.length;
			chip.classList.toggle('is-selected', n > 0);
			label.textContent = n === 0 ? 'Filter' : n === 1 ? `Filter: ${selected[0]}` : `Filter: (${n}) ${selected[0]}…`;
			clear.hidden = n === 0;
			picks.forEach((b) => {
				const on = selected.includes(b.dataset.pick!);
				b.setAttribute('aria-checked', String(on));
				b.classList.toggle('on', on);
			});
		};
		picks.forEach((b) =>
			b.addEventListener('click', () => {
				const v = b.dataset.pick!;
				const i = selected.indexOf(v);
				if (i >= 0) selected.splice(i, 1);
				else selected.push(v);
				render();
			}),
		);
		clear.addEventListener('click', () => {
			selected.length = 0;
			render();
		});
	});
</script>

<style>
	.ds {
		--teal: #0d4753;
		margin-top: 28px;
		padding: clamp(14px, 2.6vw, 24px);
		border-radius: 20px;
		background: #fbfbfb;
		border: 1px solid #ececec;
		font-family: 'Roboto', var(--font-sans);
		font-size: 14px;
		color: rgba(0, 0, 0, 0.87);
		display: grid;
		gap: 20px;
	}
	.ds :global(h4),
	.ds :global(p) {
		font-family: inherit;
		letter-spacing: 0;
	}
	.ds-head {
		display: flex;
		align-items: center;
		gap: 12px;
	}
	.ds-head b {
		display: block;
		font-weight: 500;
		font-size: 14px;
	}
	.ds-head span:not(.mark) {
		font-size: 12px;
		color: rgba(0, 0, 0, 0.6);
	}
	.mark {
		display: grid;
		place-items: center;
		width: 30px;
		height: 30px;
		border-radius: 8px;
		background: var(--teal);
		color: #fff;
		font-weight: 700;
		font-size: 17px;
	}
	.cols {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
		gap: 20px;
	}
	.col {
		padding: 16px;
		border-radius: 14px;
		background: #fff;
		border: 1px solid #ececec;
		min-width: 0;
	}
	.title {
		margin: 0 0 12px;
		font-size: 11px;
		font-weight: 500;
		letter-spacing: 0.1em !important;
		text-transform: uppercase;
		color: rgba(0, 0, 0, 0.6);
	}
	.title.spaced {
		margin-top: 18px;
	}
	.title span {
		margin-left: 8px;
		letter-spacing: 0;
		text-transform: none;
		font-weight: 400;
		color: #9e9e9e;
	}

	/* Color */
	.sw-row {
		list-style: none;
		margin: 0 0 12px;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 8px;
	}
	.sw-row.four {
		grid-template-columns: repeat(4, minmax(0, 1fr));
	}
	.sw-row li {
		display: grid;
		gap: 1px;
		font-size: 10px;
		line-height: 1.3;
	}
	.sw-row b {
		margin-top: 3px;
		font-weight: 500;
		font-size: 11px;
	}
	.sw-row li > span:last-child {
		color: #9e9e9e;
	}
	.sw {
		display: block;
		height: 34px;
		border-radius: 8px;
	}
	.sw.short {
		height: 24px;
	}
	.sw.line {
		box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.1);
	}

	/* Type */
	.type {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.type li {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 12px;
		padding: 7px 0;
		border-bottom: 1px solid #f0f0f0;
	}
	.type li:last-child {
		border-bottom: 0;
	}
	.spec {
		font-size: 11px;
		color: #9e9e9e;
		white-space: nowrap;
	}

	/* Filter */
	.states {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		padding-bottom: 14px;
		margin-bottom: 14px;
		border-bottom: 1px solid #f0f0f0;
	}
	.fchip {
		display: inline-flex;
		align-items: center;
		gap: 5px;
		height: 28px;
		padding: 0 10px;
		border-radius: 8px;
		font-size: 12px;
		white-space: nowrap;
		background: transparent;
		border: 0;
		color: rgba(0, 0, 0, 0.87);
	}
	.fchip.is-hover {
		background: rgba(13, 71, 83, 0.1);
	}
	.fchip.is-selected {
		background: rgba(13, 71, 83, 0.15);
		color: var(--teal);
	}
	.try-hint {
		margin: 0 0 10px !important;
		font-size: 11px !important;
		color: #9e9e9e !important;
	}
	.fchip.live {
		cursor: pointer;
		transition: background 0.2s;
	}
	.fchip.live:hover,
	.fchip.live:focus-within {
		background: rgba(13, 71, 83, 0.1);
	}
	.fchip.live.is-selected {
		background: rgba(13, 71, 83, 0.15);
	}
	.clear {
		all: unset;
		display: grid;
		place-items: center;
		width: 18px;
		height: 18px;
		border-radius: 50%;
		cursor: pointer;
	}
	.clear[hidden] {
		display: none;
	}
	.clear:hover,
	.clear:focus-visible {
		background: rgba(13, 71, 83, 0.15);
	}
	.menus {
		position: relative;
		margin-top: 8px;
		min-height: 296px;
	}
	.menu {
		position: relative;
		list-style: none;
		margin: 0;
		padding: 6px 0;
		width: 170px;
		background: #fff;
		border: 1px solid #e3e3e3;
		border-radius: 8px;
		box-shadow: 0 8px 24px rgba(0, 0, 0, 0.1);
	}
	.mitem {
		position: static;
	}
	.menu button {
		all: unset;
		box-sizing: border-box;
		width: 100%;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 8px;
		padding: 5px 12px;
		font-size: 12px;
		line-height: 1.3;
		cursor: pointer;
		color: rgba(0, 0, 0, 0.87);
	}
	.menu button:hover,
	.menu button:focus-visible,
	.mitem.has:hover > button,
	.mitem.has:focus-within > button {
		background: rgba(13, 71, 83, 0.1);
	}
	.menu button:focus-visible {
		outline: 2px solid var(--teal);
		outline-offset: -2px;
	}
	/* the submenu aligns with the top of its parent list, as in the Figma file */
	.sub {
		display: none;
		position: absolute;
		top: -1px;
		left: calc(100% - 4px);
		z-index: 5;
		width: 190px;
		max-height: 296px;
		overflow-y: auto;
	}
	.mitem.has:hover > .sub,
	.mitem.has:focus-within > .sub {
		display: block;
	}
	.sub button.on {
		background: rgba(13, 71, 83, 0.15);
		color: var(--teal);
		font-weight: 500;
	}
	.sub button.on::after {
		content: '✓';
		font-size: 11px;
	}

	@media (max-width: 820px) {
		.cols {
			grid-template-columns: 1fr;
		}
		.menus {
			min-height: 0;
		}
		.menu {
			width: 100%;
		}
		/* on phones the submenu opens inline under its parent */
		.sub {
			position: static;
			width: auto;
			max-height: 220px;
			margin: 4px 10px 8px;
			box-shadow: none;
		}
	}
</style>
