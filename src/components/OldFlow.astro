---
// The previous tracker creation flow, drawn as a diagram: eight steps on the
// Suggested prompts path, with the two pain points flagged.
import Plus from '@lucide/astro/icons/plus';
import TriangleAlert from '@lucide/astro/icons/triangle-alert';

const types = [
	{ name: 'Product Category Analysis', note: 'the old standard template' },
	{ name: 'Run My Own' },
	{ name: 'Suggested prompts', leadsOn: true },
	{ name: 'Pitch report' },
	{ name: 'Word association' },
];
const methods = ['Let Evertune generate', 'Give instruction', 'Enter topics'];
---

<div class="oldflow">
	<ol class="steps">
		<li class="step">
			<span class="n">1</span>
			<h4>Enter brand details</h4>
			<p>Brand, location and language.</p>
		</li>

		<li class="step">
			<span class="n">2</span>
			<h4>Pick a type</h4>
			<ul class="chips">
				{
					types.map((t) => (
						<li class:list={['chip', { on: t.leadsOn }]}>
							{t.name}
							{t.note && <small>{t.note}</small>}
						</li>
					))
				}
			</ul>
			<span class="flag"><TriangleAlert size={14} strokeWidth={1.75} aria-hidden="true" />Hard to choose</span>
		</li>

		<li class="step">
			<span class="n">3</span>
			<h4>Pick how to start</h4>
			<p class="only">Only for Suggested prompts</p>
			<ul class="chips">
				{methods.map((m) => <li class="chip">{m}</li>)}
			</ul>
		</li>

		<li class="step">
			<span class="n">4</span>
			<h4>Review prompts</h4>
			<p>Edit topics and prompts.</p>
			<span class="chip add"><Plus size={14} strokeWidth={1.75} aria-hidden="true" />Add topic or prompt</span>
			<span class="flag"><TriangleAlert size={14} strokeWidth={1.75} aria-hidden="true" />Hard to add more</span>
		</li>

		<li class="step">
			<span class="n">5</span>
			<h4>Enter competitors</h4>
		</li>

		<li class="step">
			<span class="n">6</span>
			<h4>Select models</h4>
		</li>

		<li class="step">
			<span class="n">7</span>
			<h4>Select refresh cadence</h4>
		</li>

		<li class="step">
			<span class="n">8</span>
			<h4>Review everything</h4>
			<p>Including prompt usage.</p>
		</li>
	</ol>
	<p class="count"><strong>8 steps</strong> on the Suggested prompts path, before a single prompt could run.</p>
</div>

<style>
	.oldflow {
		margin-top: 28px;
		padding: clamp(16px, 3vw, 28px);
		border-radius: 20px;
		background: linear-gradient(121deg, #ffffff 0%, #fff3ec 100%);
		border: 1px solid rgba(90, 50, 30, 0.07);
	}
	.steps {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 28px 26px;
		counter-reset: none;
	}
	.step {
		position: relative;
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 8px;
		padding: 16px;
		border-radius: 12px;
		background: #fff;
		border: 1px solid rgba(90, 50, 30, 0.1);
		box-shadow: 0 6px 18px rgba(120, 70, 40, 0.06);
	}
	/* Arrow to the next step */
	.step::after {
		content: '→';
		position: absolute;
		top: 50%;
		right: -22px;
		translate: 0 -50%;
		color: #b0694a;
		font-size: 1.1rem;
	}
	.step:nth-child(4)::after {
		content: '↓';
		top: auto;
		bottom: -26px;
		right: 14px;
		translate: none;
	}
	.step:nth-child(8)::after {
		content: none;
	}
	.n {
		display: grid;
		place-items: center;
		width: 28px;
		height: 28px;
		border-radius: 8px;
		background: #fbede5;
		color: #b0694a;
		font-size: 0.85rem;
	}
	h4 {
		margin: 0;
		font-family: var(--font-serif);
		font-weight: 500;
		font-size: 1.3rem;
		line-height: 1.15;
	}
	.step p {
		margin: 0;
		font-size: 0.9rem;
		color: var(--muted);
		line-height: 1.4;
	}
	.step p.only {
		font-size: 0.75rem;
		text-transform: uppercase;
		letter-spacing: 0.08em;
	}
	.chips {
		list-style: none;
		margin: 2px 0 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 6px;
		width: 100%;
	}
	.chip {
		display: inline-flex;
		flex-direction: column;
		font-size: 0.85rem;
		line-height: 1.3;
		padding: 6px 10px;
		border-radius: 8px;
		background: #faf7f4;
		border: 1px solid rgba(90, 50, 30, 0.1);
	}
	.chip small {
		font-size: 0.75rem;
		color: var(--muted);
	}
	.chip.on {
		background: #fbede5;
		border-color: rgba(176, 105, 74, 0.45);
	}
	.chip.add {
		flex-direction: row;
		align-items: center;
		gap: 6px;
		background: #fff;
		border-style: dashed;
	}
	.flag {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		margin-top: 2px;
		padding: 3px 8px;
		border-radius: 999px;
		font-size: 0.75rem;
		color: #a3442b;
		background: #fdeae4;
	}
	.count {
		margin: 22px 0 0;
		text-align: center;
		color: var(--muted);
	}
	.count strong {
		color: var(--fg);
		font-weight: 500;
	}
	@media (max-width: 820px) {
		.steps {
			grid-template-columns: 1fr;
			gap: 30px;
		}
		.step::after,
		.step:nth-child(4)::after {
			content: '↓';
			top: auto;
			bottom: -27px;
			right: auto;
			left: 24px;
			translate: none;
		}
	}
</style>
