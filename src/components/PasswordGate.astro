---
// A soft password gate shared by the pages that hold the private work.
//
//   mode="scroll"    opens when the visitor scrolls past `#gate-sentinel` (the homepage)
//   mode="immediate" opens as soon as the page loads (a case study)
//
// The content to protect goes inside an element with id="gated". Until the password is entered it is
// blurred and inert. An unlock is remembered in this browser (localStorage) and shared by every page on
// the site, so the password is only asked for once.
//
// This keeps casual visitors out. It is not real security: the page's content is still in its HTML, and
// only a salted SHA-256 hash of the password is stored here (never the password itself).
import Lock from '@lucide/astro/icons/lock';
import { base } from '../lib/base';

interface Props {
	mode?: 'scroll' | 'immediate';
}

const { mode = 'scroll' } = Astro.props;
const home = `${base}/`;
---

<dialog id="gate" class="gate" data-mode={mode} aria-labelledby="gate-title">
	<form id="gate-form" autocomplete="off">
		<span class="gate-icon"><Lock size={20} strokeWidth={1.75} aria-hidden="true" /></span>
		<h2 id="gate-title">This work is private</h2>
		<p class="gate-note">Enter the password to see the case studies and more.</p>
		<label class="sr-only" for="gate-input">Password</label>
		<input id="gate-input" type="password" placeholder="Password" autocomplete="off" required />
		<p id="gate-error" class="gate-error" role="alert" hidden>That password isn’t right. Try again.</p>
		<button type="submit" class="gate-submit">Unlock</button>
		{
			mode === 'immediate' ? (
				<a class="gate-back" href={home}>← Back to home</a>
			) : (
				<button type="button" id="gate-back" class="gate-back">Back to top</button>
			)
		}
	</form>
</dialog>

<script>
	const SALT = 'tinu-portfolio::';
	const HASH = '40b39b73b83ef876d85a9b09e934491c937d612581d22cd28b1d281d37893455';
	const STORE = 'portfolio-unlocked';

	const root = document.documentElement;
	const gated = document.getElementById('gated');
	const dialog = document.getElementById('gate') as HTMLDialogElement;
	const form = document.getElementById('gate-form') as HTMLFormElement;
	const input = document.getElementById('gate-input') as HTMLInputElement;
	const error = document.getElementById('gate-error')!;
	const mode = dialog.dataset.mode;

	const sha256 = async (text: string) => {
		const bytes = await crypto.subtle.digest('SHA-256', new TextEncoder().encode(SALT + text));
		return [...new Uint8Array(bytes)].map((b) => b.toString(16).padStart(2, '0')).join('');
	};

	if (gated && !root.classList.contains('pw-unlocked')) {
		gated.setAttribute('inert', '');

		const openGate = () => {
			if (dialog.open) return;
			dialog.showModal();
			root.style.overflow = 'hidden';
			input.focus();
		};
		const closeGate = () => {
			dialog.close();
			root.style.overflow = '';
		};

		if (mode === 'scroll') {
			const sentinel = document.getElementById('gate-sentinel')!;
			let armed = true; // false right after "Back to top", until the visitor is above the trigger again
			const check = () => {
				if (root.classList.contains('pw-unlocked')) return;
				const top = sentinel.getBoundingClientRect().top;
				if (top >= innerHeight * 0.7) armed = true;
				else if (armed) openGate();
			};
			addEventListener('scroll', check, { passive: true });
			addEventListener('resize', check);
			check();
			document.getElementById('gate-back')!.addEventListener('click', () => {
				armed = false;
				closeGate();
				scrollTo({ top: 0, behavior: 'smooth' });
			});
		} else {
			openGate();
		}

		// Esc must not skip the gate
		dialog.addEventListener('cancel', (e) => e.preventDefault());

		form.addEventListener('submit', async (e) => {
			e.preventDefault();
			let ok = false;
			let message = 'That password isn’t right. Try again.';
			try {
				ok = (await sha256(input.value)) === HASH;
			} catch {
				message = 'This browser can’t check the password here.';
			}
			if (ok) {
				root.classList.add('pw-unlocked');
				gated.removeAttribute('inert');
				try {
					localStorage.setItem(STORE, '1');
				} catch {}
				closeGate();
			} else {
				error.textContent = message;
				error.hidden = false;
				dialog.classList.remove('shake');
				void dialog.offsetWidth; // restart the animation
				dialog.classList.add('shake');
				input.select();
			}
		});
	}
</script>

<!-- Global: the protected element sits outside this component -->
<style is:global>
	.gated {
		transition: filter 0.6s ease;
	}
	html:not(.pw-unlocked) .gated {
		filter: blur(14px);
		pointer-events: none;
		user-select: none;
	}
	html {
		scrollbar-gutter: stable;
	}
	@media (prefers-reduced-motion: reduce) {
		.gated {
			transition: none;
		}
	}
</style>

<style>
	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
	}
	.gate {
		width: min(420px, calc(100vw - 32px));
		padding: 32px;
		border: 1px solid #e3e3e3;
		border-radius: 24px;
		background: #fff;
		color: var(--fg);
		box-shadow: 0 30px 80px rgba(0, 0, 0, 0.16);
	}
	.gate::backdrop {
		background: rgba(255, 255, 255, 0.4);
		-webkit-backdrop-filter: blur(6px);
		backdrop-filter: blur(6px);
	}
	.gate form {
		display: grid;
		gap: 14px;
		justify-items: start;
	}
	.gate-icon {
		display: grid;
		place-items: center;
		width: 44px;
		height: 44px;
		border-radius: 12px;
		background: #efefef;
		color: #555;
	}
	.gate h2 {
		margin: 4px 0 0;
		font-size: 1.9rem;
		line-height: 1.15;
	}
	.gate-note {
		margin: 0;
		color: var(--muted);
	}
	.gate input {
		box-sizing: border-box;
		width: 100%;
		height: 46px;
		padding: 0 14px;
		border: 1px solid #d6d6d6;
		border-radius: 12px;
		font: inherit;
		font-size: 1rem;
		color: var(--fg);
		background: #fff;
	}
	.gate input:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 2px;
	}
	.gate-error {
		margin: -4px 0 0;
		font-size: 0.9rem;
		color: #b3261e;
	}
	.gate-submit {
		all: unset;
		box-sizing: border-box;
		width: 100%;
		height: 46px;
		display: grid;
		place-items: center;
		border-radius: 999px;
		background: #2b2b2b;
		color: #fff;
		cursor: pointer;
		transition: background 0.2s;
	}
	.gate-submit:hover {
		background: #000;
	}
	.gate-submit:focus-visible,
	.gate-back:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 2px;
	}
	.gate-back {
		all: unset;
		cursor: pointer;
		color: var(--muted);
		font-size: 0.9rem;
		text-decoration: underline;
		text-underline-offset: 4px;
	}
	.gate-back:hover {
		color: var(--fg);
	}
	.shake {
		animation: shake 0.4s;
	}
	@keyframes shake {
		20%,
		60% {
			transform: translateX(-6px);
		}
		40%,
		80% {
			transform: translateX(6px);
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.shake {
			animation: none;
		}
	}
</style>
