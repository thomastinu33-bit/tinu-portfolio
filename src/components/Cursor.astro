---
// Fairy dust: tiny sparkles and glints that shed from the mouse as it moves, then drift down and fade.
// The normal pointer stays. Only runs on devices with a mouse, and stays off for visitors who prefer
// reduced motion.
---

<canvas class="fairy-dust" aria-hidden="true"></canvas>

<script>
	const canvas = document.querySelector<HTMLCanvasElement>('.fairy-dust');
	const canHover = matchMedia('(hover: hover) and (pointer: fine)').matches;
	const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
	const ctx = canvas?.getContext('2d');

	if (canvas && ctx && canHover && !reduceMotion) {
		// Soft, saturated pastels: gold, rose, violet, sky, mint. They need some colour to show on a light page.
		const colors = ['#f0c27a', '#f3a9c3', '#b7a6f5', '#9ccbf5'];
		const MAX = 90;

		type Dust = {
			x: number;
			y: number;
			vx: number;
			vy: number;
			size: number;
			life: number;
			age: number;
			color: string;
			star: boolean;
			phase: number;
		};
		const dust: Dust[] = [];

		let dpr = 1;
		const resize = () => {
			dpr = Math.min(devicePixelRatio || 1, 2);
			canvas.width = innerWidth * dpr;
			canvas.height = innerHeight * dpr;
			canvas.style.width = `${innerWidth}px`;
			canvas.style.height = `${innerHeight}px`;
			ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
		};
		resize();
		addEventListener('resize', resize);

		const spawn = (x: number, y: number) => {
			if (dust.length >= MAX) dust.shift();
			dust.push({
				x: x + (Math.random() - 0.5) * 10,
				y: y + (Math.random() - 0.5) * 10,
				vx: (Math.random() - 0.5) * 0.4,
				vy: Math.random() * 0.4 - 0.2,
				size: 1.4 + Math.random() * 2.6,
				life: 700 + Math.random() * 700,
				age: 0,
				color: colors[(Math.random() * colors.length) | 0],
				star: Math.random() < 0.2,
				phase: Math.random() * Math.PI * 2,
			});
		};

		// Leave a sparkle each time the mouse has travelled about 22px, so slow movement stays light and a flick
		// leaves a thin trail rather than a cloud.
		let lastX = -1;
		let lastY = -1;
		addEventListener('pointermove', (e) => {
			if (lastX < 0) {
				lastX = e.clientX;
				lastY = e.clientY;
			}
			const dx = e.clientX - lastX;
			const dy = e.clientY - lastY;
			const dist = Math.hypot(dx, dy);
			if (dist >= 22) {
				const steps = Math.min(Math.floor(dist / 22), 4);
				for (let i = 1; i <= steps; i++) spawn(lastX + (dx * i) / steps, lastY + (dy * i) / steps);
				lastX = e.clientX;
				lastY = e.clientY;
				start();
			}
		});
		document.addEventListener('pointerleave', () => {
			lastX = -1;
			lastY = -1;
		});

		const star = (x: number, y: number, r: number) => {
			ctx.beginPath();
			ctx.moveTo(x, y - r);
			ctx.quadraticCurveTo(x, y, x + r, y);
			ctx.quadraticCurveTo(x, y, x, y + r);
			ctx.quadraticCurveTo(x, y, x - r, y);
			ctx.quadraticCurveTo(x, y, x, y - r);
			ctx.fill();
		};

		let running = false;
		let prev = 0;
		const frame = (t: number) => {
			const dt = Math.min(t - prev, 50);
			prev = t;
			ctx.clearRect(0, 0, innerWidth, innerHeight);
			for (let i = dust.length - 1; i >= 0; i--) {
				const d = dust[i];
				d.age += dt;
				if (d.age >= d.life) {
					dust.splice(i, 1);
					continue;
				}
				d.x += d.vx * (dt / 16);
				d.y += d.vy * (dt / 16);
				d.vy += 0.006 * (dt / 16); // a slow fall
				const k = d.age / d.life;
				const twinkle = 0.65 + 0.35 * Math.sin(d.age / 90 + d.phase);
				const alpha = (k < 0.15 ? k / 0.15 : 1 - (k - 0.15) / 0.85) * twinkle;
				ctx.fillStyle = d.color;
				ctx.globalAlpha = alpha * 0.16;
				ctx.beginPath();
				ctx.arc(d.x, d.y, d.size * 2.2, 0, Math.PI * 2);
				ctx.fill();
				ctx.globalAlpha = alpha;
				if (d.star) star(d.x, d.y, d.size * 2.4 * (1 - k * 0.4));
				else {
					ctx.beginPath();
					ctx.arc(d.x, d.y, d.size * 0.7, 0, Math.PI * 2);
					ctx.fill();
				}
			}
			ctx.globalAlpha = 1;
			if (dust.length) requestAnimationFrame(frame);
			else running = false;
		};
		function start() {
			if (running) return;
			running = true;
			prev = performance.now();
			requestAnimationFrame(frame);
		}
	}
</script>

<style is:global>
	.fairy-dust {
		position: fixed;
		top: 0;
		left: 0;
		z-index: 5;
		pointer-events: none;
	}
</style>
